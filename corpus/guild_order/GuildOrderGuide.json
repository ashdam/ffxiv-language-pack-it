  "entries": [
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_SELECT_MENU_TITLE", "hash": "012CE32C104E897C", "target": "Che cosa ti interessa oggi?" },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_SELECT_MENU_00", "hash": "F5E2704C09D21B2F", "target": "Partecipare a un guildhest." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_SELECT_MENU_01", "hash": "9E0E895A667A537F", "target": "Saperne di più sui guildhest." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_SELECT_MENU_02", "hash": "DD157D045060BB90", "target": "Niente." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_SELECT_STAGE_MENU_TITLE", "hash": "AA81D1747CBF84A1", "target": "Seleziona un'operazione." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_SELECT_STAGE_MENU_CANCEL", "hash": "78E005FBF58BA15F", "target": "Niente." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_START_MENU_TITLE", "hash": "B5AC8B3DD49F01CD", "target": "Avviare l'operazione?" },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_START_MENU_YES", "hash": "CF1467880C8B9046", "target": "Sì" },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_START_MENU_NO", "hash": "BE6AF37340994896", "target": "No" },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_INFO_TALK_00", "hash": "8B61FC6657494273", "target": "I guildhest sono brevi operazioni per gruppi supervisionate dalla Gilda degli Avventurieri." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_INFO_TALK_01", "hash": "B05AFFBA88415412", "target": "Oltre a svolgersi in istanze, le battaglie hanno limiti di tempo variabili." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_INFO_TALK_02", "hash": "1185AFE72F573802", "target": "Le ricompense per il completamento dell'operazione dipendono dalle prestazioni del gruppo. Riceverai un bonus la prima volta che completerai un guildhest con ciascuna classe." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_INFO_TALK_03", "hash": "EE149A8CFE8AEF5F", "target": "Riceverai un bonus anche completando l'operazione con un numero minimo di K.O." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_INFO_TALK_04", "hash": "9F8C4D6BDD56D9E8", "target": "Nuove operazioni diventano disponibili man mano che sali di livello o completi i guildhest esistenti. Alcune si possono sbloccare solo parlando con determinati battlewarden." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_ERROR_TALK", "hash": "21ECD85496B5887A", "target": "Non è stato possibile avviare «<sheet(InstanceContent,lnum2,3)>»." }
  ]
