    { "gameKey": "GeneralAction#13.0", "hash": "329706B15423F553", "target": "Innesto Avanzato di Materia" },
    { "gameKey": "GeneralAction#13.1", "hash": "0AC4395138BEE39A", "target": "Applica la materia a un'arma o a un'armatura. Puoi inserirla anche in oggetti senza slot liberi, ma il successo non è garantito." },
    { "gameKey": "GeneralAction#14.0", "hash": "B480B44A0087919C", "target": "Estrazione Materia" },
    { "gameKey": "GeneralAction#14.1", "hash": "99A614D90E70AFAE", "target": "Estrae l'etere da un oggetto con legame spirituale completo e ricristallizza il residuo ottenuto in una sostanza concentrata chiamata «materia»." },
