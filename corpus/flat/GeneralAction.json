  "entries": [
    { "gameKey": "GeneralAction#1.0", "hash": "F172C0074052DC60", "target": "Attacco automatico" },
    { "gameKey": "GeneralAction#1.1", "hash": "491F40B1F8E4ED43", "target": "Attacca automaticamente il bersaglio attuale a intervalli regolari determinati dall'arma equipaggiata." },
    { "gameKey": "GeneralAction#2.0", "hash": "33A46B5B60E9E964", "target": "Salto" },
    { "gameKey": "GeneralAction#2.1", "hash": "F20F103FE205C548", "target": "Spicca un salto da terra o da un altro appoggio, flettendo ed estendendo bruscamente le gambe." },
    { "gameKey": "GeneralAction#3.0", "hash": "0453C0983E4338A9", "target": "Trascendenza" },
    { "gameKey": "GeneralAction#3.1", "hash": "615074376A682417", "target": "Consuma l'energia accumulata nella barra di trascendenza del gruppo per eseguire una potente tecnica di combattimento. La tecnica dipende dal <colortype(500)><edgecolortype(501)>ruolo<edgecolortype(0)><colortype(0)> del membro del gruppo che la attiva.<br>Difensore: aumenta la difesa del gruppo (raggio d'azione: 50 yalmi).<br>DPS da mischia: attacco a bersaglio singolo.<br>DPS fisico a distanza: attacca tutti i bersagli in linea retta (gittata: 30 yalmi).<br>DPS magico a distanza: attacco ad area (raggio: 8/10/15 yalmi).<br>Curatore: ripristina i PV. Al livello 3, rianima i membri del gruppo (raggio d'azione: 50 yalmi).<br>※Se al momento della rianimazione il bersaglio non è affetto da Debolezza, tornerà in vita senza questo status. Se invece ne è affetto, la durata dello status verrà reimpostata." },
    { "gameKey": "GeneralAction#4.0", "hash": "756A7B05B883A50C", "target": "Scatto" },
    { "gameKey": "GeneralAction#4.1", "hash": "44383BF4902D4A34", "target": "Aumenta la velocità di movimento.<br><colortype(504)><edgecolortype(505)>Durata: <edgecolortype(0)><colortype(0)>10s (20s fuori dal combattimento)<br>※Non disponibile in PvP." },
    { "gameKey": "GeneralAction#5.0", "hash": "4DA935E90959B1A1", "target": "Desintesi" },
    { "gameKey": "GeneralAction#5.1", "hash": "65027456863EA414", "target": "Scompone un oggetto in uno o più dei materiali originali." },
    { "gameKey": "GeneralAction#6.0", "hash": "4E8E82F33E3E09FC", "target": "Ripara" },
    { "gameKey": "GeneralAction#6.1", "hash": "1F8B0531582F13E3", "target": "Usa la materia oscura per riparare l'equipaggiamento danneggiato." },
    { "gameKey": "GeneralAction#7.0", "hash": "D1226DC8E16704ED", "target": "Teletrasporto" },
    { "gameKey": "GeneralAction#7.1", "hash": "FE8D5981F73409D9", "target": "Trasforma il tuo corpo in etere e ti teletrasporta all'istante presso qualsiasi eterite con cui hai già stabilito una sintonia. All'arrivo a destinazione è richiesta una tariffa in gil." },
    { "gameKey": "GeneralAction#8.0", "hash": "E1E9FF3ECC441519", "target": "Ritorna" },
    { "gameKey": "GeneralAction#8.1", "hash": "B99238801D80D91A", "target": "Torna immediatamente al tuo punto di ritorno attuale." },
    { "gameKey": "GeneralAction#9.0", "hash": "BA5E06D5B9C6C104", "target": "Roulette delle Cavalcature" },
