    { "gameKey": "BaseParam#1.2", "hash": "33B3502FF4EDCBE6", "target": "Influisce sui danni fisici inflitti dalle armi da Gladiatore, Incursore, Cavaliere Oscuro, Eterlama, Pugile, Lanciere, Samurai, Mietitore, Domatore, Taumaturgo, Arcanista, Mago Rosso, Pittomante, Mago Blu, Incantatore, Astrologo e Saggio." },
