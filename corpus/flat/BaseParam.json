    { "gameKey": "BaseParam#19.1", "hash": "C2AED881D3265917", "target": "Tenacia" },
    { "gameKey": "BaseParam#19.2", "hash": "13D7C535E77A1366", "target": "Influisce sui danni fisici e magici inflitti e subiti e sui PV ripristinati. Più alto è il valore, maggiori sono i danni inflitti e i PV ripristinati e minori sono i danni subiti. Si applica solo quando il ruolo è tank." },
    { "gameKey": "BaseParam#20.1", "hash": "F720BEFB7A5A0696", "target": "Potenza d'Attacco" },
    { "gameKey": "BaseParam#20.2", "hash": "2DBD71A0D4262110", "target": "Influisce sui danni inflitti dagli attacchi fisici. Più alto è il valore, maggiori sono i danni inflitti." },
    { "gameKey": "BaseParam#21.1", "hash": "A4D2D9D27604F1FB", "target": "Difesa" },
    { "gameKey": "BaseParam#21.2", "hash": "32A52C6C58EDECC0", "target": "Influisce sui danni subiti dagli attacchi fisici. Più alto è il valore, minori sono i danni subiti." },
    { "gameKey": "BaseParam#22.1", "hash": "BEF8EE86262AD39C", "target": "Probabilità di Colpo Diretto" },
    { "gameKey": "BaseParam#22.2", "hash": "7354943AB7BF2CF8", "target": "Influisce sulla probabilità che gli attacchi fisici e magici infliggano colpi diretti, causando danni leggermente superiori a quelli normali. Più alto è il valore, maggiore è la frequenza dei colpi diretti. Valori più alti aumentano anche i danni delle azioni che garantiscono colpi diretti." },
