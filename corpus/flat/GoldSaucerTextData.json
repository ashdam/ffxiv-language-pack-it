    { "gameKey": "GoldSaucerTextData#51", "hash": "C57DA856F2682C53", "target": "Vasi in fuga" },
    { "gameKey": "GoldSaucerTextData#52", "hash": "60E7E85E69077756", "target": "Vasi consegnati" },
    { "gameKey": "GoldSaucerTextData#61", "hash": "9B419500ED2259E7", "target": "Il ballo della vita" },
    { "gameKey": "GoldSaucerTextData#62", "hash": "A02D0C58F2FF6196", "target": "Sali sul palco principale e memorizza la coreografia per il grande numero di danza." },
    { "gameKey": "GoldSaucerTextData#63", "hash": "5DA7F609BA7D6CB1", "target": "Memorizza la sequenza dei Signori e delle Signore della Danza ed esegui alla perfezione almeno dieci movimenti al loro segnale." },
    { "gameKey": "GoldSaucerTextData#64", "hash": "EAFA31257BA70C03", "target": "Prima strofa" },
    { "gameKey": "GoldSaucerTextData#65", "hash": "85AA84002FCBFD1A", "target": "Seconda strofa" },
    { "gameKey": "GoldSaucerTextData#66", "hash": "0D8FB4B3378C85FB", "target": "Terza strofa" },
    { "gameKey": "GoldSaucerTextData#67", "hash": "8BFDDDD2C857069F", "target": "Quarta strofa" },
    { "gameKey": "GoldSaucerTextData#68", "hash": "1B148750F424EB4B", "target": "Mosse impeccabili" },
    { "gameKey": "GoldSaucerTextData#71", "hash": "F1BCFE488286AB5C", "target": "Via col vento" },
    { "gameKey": "GoldSaucerTextData#72", "hash": "558CEE55B754815D", "target": "Sali sul palco principale e metti alla prova la tua astuzia contro Typhon─sbuffatore d'eccezione. Riuscirai a restare sul palco fino allo scadere del tempo o finirai via col vento?" },
    { "gameKey": "GoldSaucerTextData#73", "hash": "BD7F39E18FE67D3D", "target": "Prevedi dove si abbatterà la prossima eruzione nasale di Typhon e spostati dove pensi di essere al sicuro." },
    { "gameKey": "GoldSaucerTextData#74", "hash": "492431748E8F0043", "target": "Sbuffi evitati" },
    { "gameKey": "GoldSaucerTextData#81", "hash": "FFBE01A11A731A5F", "target": "Una metamorfosi in cui credere" },
    { "gameKey": "GoldSaucerTextData#82", "hash": "A9B2C0BFC23C323D", "target": "Un perfido imp ha preso le sembianze di un rispettabile cliente del Gold Saucer e si nasconde da qualche parte nel locale. Trova il sosia perfetto del committente del GATE e somministragli una buona dose di brightash." },
    { "gameKey": "GoldSaucerTextData#91", "hash": "D5E0D1B105C0F219", "target": "Sull'orlo del precipizio" },
    { "gameKey": "GoldSaucerTextData#101", "hash": "56A899DA8BBEFF5C", "target": "Acquistare un biglietto del Mini Cactpot" },
