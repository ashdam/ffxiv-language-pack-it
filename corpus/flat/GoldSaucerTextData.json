    { "gameKey": "GoldSaucerTextData#110", "hash": "84D84A7AAD4E841E", "target": "Eccoti sul percorso d'addestramento!" },
    { "gameKey": "GoldSaucerTextData#111", "hash": "BF96EA78D17D50F6", "target": "Segui tutte le istruzioni dell'allenatore." },
    { "gameKey": "GoldSaucerTextData#112", "hash": "083C747FAFA061C5", "target": "Percorso d'addestramento completato!" },
    { "gameKey": "GoldSaucerTextData#113", "hash": "44DDF474A61E236B", "target": "???" },
    { "gameKey": "GoldSaucerTextData#114", "hash": "331032DD412E0D00", "target": "Accelera." },
    { "gameKey": "GoldSaucerTextData#115", "hash": "B9B72CBD091A456E", "target": "Accelera fino a esaurire la resistenza." },
    { "gameKey": "GoldSaucerTextData#116", "hash": "7420BA74E4139502", "target": "Accelera fino alla velocità massima, poi rallenta." },
    { "gameKey": "GoldSaucerTextData#117", "hash": "A1B2E1AD8FF332E9", "target": "Sterza." },
    { "gameKey": "GoldSaucerTextData#118", "hash": "D5BAA5E9CB636E76", "target": "Attiva una piastra magica." },
    { "gameKey": "GoldSaucerTextData#119", "hash": "2381DFBA4F0A0797", "target": "Salta." },
    { "gameKey": "GoldSaucerTextData#120", "hash": "F13C0DB98DE78C14", "target": "Apri un forziere." },
    { "gameKey": "GoldSaucerTextData#121", "hash": "45338633B4148BD3", "target": "Usa un oggetto da corsa." },
    { "gameKey": "GoldSaucerTextData#131", "hash": "7A864D6C4FC26089", "target": "Le regole del Mini Cactpot sono semplici. Per prima cosa, scegli tre numeri fra gli otto nascosti sul biglietto. Poi seleziona una delle otto linee─verticale, orizzontale o diagonale." },
    { "gameKey": "GoldSaucerTextData#132", "hash": "F1E5994A1E7CD945", "target": "Scelta una linea, tutti i numeri vengono scoperti: la somma dei tre numeri nella linea selezionata determina il premio in MGP. Tutto qui!" },
    { "gameKey": "GoldSaucerTextData#133", "hash": "AB0CA2D93927EBE4", "target": "Ora devi soltanto scegliere un numero di quattro cifre. Il numero vincente verrà estratto in seguito. Se l'ultima cifra del tuo numero corrisponde a quella del numero vincente, vinci il 4º premio. Se corrispondono le ultime due, vinci il 3º premio. Se corrispondono le ultime tre, vinci il 2º premio, e se corrispondono tutte, ti aggiudichi il primo premio." },
