    { "gameKey": "MJIText#40", "hash": "FE0BBD290EF9AA15", "target": "Cascate Fatali" },
    { "gameKey": "MJIText#41", "hash": "A36DC2322BC15FBA", "target": "Boschi Selvaggi" },
    { "gameKey": "MJIText#42", "hash": "C7B5E3D9F7E219E9", "target": "Spiagge Sinuose" },
    { "gameKey": "MJIText#43", "hash": "3967BEE206A20C69", "target": "Montagne Muschiose" },
    { "gameKey": "MJIText#44", "hash": "D2A7BFC8D4902B08", "target": "Germoglio" },
    { "gameKey": "MJIText#45", "hash": "AFFFBFA64FBD7EFE", "target": "Piantina" },
    { "gameKey": "MJIText#46", "hash": "4C4EA395B83506EF", "target": "Fioritura" },
    { "gameKey": "MJIText#47", "hash": "57BCF7DA36FF35AF", "target": "Il tuo primo punto d'appoggio in questa terra selvaggia, costruito in fretta con materiali reperiti in natura." },
    { "gameKey": "MJIText#48", "hash": "B1C0E2B1B3F85B45", "target": "Il fulcro delle tue attività sull'isola, con un tocco di comodità in più rispetto al minimo indispensabile." },
    { "gameKey": "MJIText#49", "hash": "5423FBD015B63289", "target": "Il pilastro della tua fiorente attività sull'isola, completamente rinnovato dai mammets esperti in falegnameria." },
    { "gameKey": "MJIText#50", "hash": "BA22E7D21BB11B67", "target": "Quattro pareti e un tetto sotto cui i tuoi mammets, pieni d'entusiasmo, fabbricano oggetti d'artigianato." },
    { "gameKey": "MJIText#51", "hash": "7A9448F6945BC14F", "target": "Una struttura pratica ma modesta, dove i tuoi affidabili mammets fabbricano prodotti artigianali." },
    { "gameKey": "MJIText#52", "hash": "80A1EA805EDCAAEF", "target": "Un luogo di lavoro signorile, progettato per i mammets artigiani professionisti." },
    { "gameKey": "MJIText#53", "hash": "77E28AB2D227CF9B", "target": "Un magazzino essenziale per i materiali dell'isola e un punto di ritrovo per i mammets esploratori." },
    { "gameKey": "MJIText#54", "hash": "D8E980370B3409C7", "target": "Una struttura con spazio di stoccaggio e risorse sufficienti per sostenere una squadra affidabile di mammets raccoglitori." },
    { "gameKey": "MJIText#55", "hash": "BE5204087E12FC77", "target": "Un ampio deposito professionale popolato da mammets raccoglitori d'élite." },
    { "gameKey": "MJIText#56", "hash": "C42037F5AE413FF9", "target": "Un lotto vuoto dalle grandi potenzialità architettoniche." },
    { "gameKey": "MJIText#57", "hash": "C9682342FB85033E", "target": "Le enormi pale rotanti non soddisferanno le tue ambizioni di gloria, ma azioneranno il mulino che macina il grano. I mammets dell'isola le adorano." },
    { "gameKey": "MJIText#58", "hash": "0F5C82B39126B04E", "target": "Un rifugio appartato tra i rami alti e rigogliosi. I mammets dell'isola lo adorano." },
    { "gameKey": "MJIText#59", "hash": "1ACC370C77083739", "target": "Gli automi incaricati di regolarne la temperatura sostengono, animati dalle migliori intenzioni, che questo grazioso bagno all'aperto bruci via le impurità dalla pelle e la lasci pulita... se sopravvivi. Amato dai mammets dell'isola." },
    { "gameKey": "MJIText#60", "hash": "4DD06BE263B87A25", "target": "Per costruire questo faro nello stile di Limsa Lominsa, i mammets architetti hanno superato la scarsità di materiali e gli accesi contrasti creativi. Amato dai mammets dell'isola." },
    { "gameKey": "MJIText#61", "hash": "F23D90896867CBEF", "target": "Per rispondere a un quesito annoso: una lontra <italic(1)>che spruzza<italic(0)> acqua potrebbe essere davvero più bizzarra di una lontra fuori dall'acqua. Amata dai mammets dell'isola." },
    { "gameKey": "MJIText#62", "hash": "FC1D8A18ECEA6DDC", "target": "Campo Coltivato" },
    { "gameKey": "MJIText#63", "hash": "A08483F4565D2E4C", "target": "Pascolo" },
    { "gameKey": "MJIText#64", "hash": "11DA545A1628A617", "target": "Aiuole di terra fertile e ben dissodata, ideali per coltivare." },
    { "gameKey": "MJIText#65", "hash": "3D940F0B79DFE3F9", "target": "Un campo verde e rigoglioso, adatto a ospitare animali di ogni forma e dimensione." },
    { "gameKey": "MJIText#66", "hash": "6ABB3F169506C94A", "target": "Registro del Custode dell'Isola" },
    { "gameKey": "MJIText#67", "hash": "5EFEC6D34174DCCE", "target": "Giardino Saltellante" },
    { "gameKey": "MJIText#68", "hash": "432D594B8E8178F0", "target": "Questo cosiddetto «giardino» è in realtà un parco giochi, ideato da un gruppo di mammets che trama per creare un paradiso segreto tutto loro, un punto di riferimento alla volta. Amato dai mammets dell’isola." },
    { "gameKey": "MJIText#69", "hash": "BC6B5F3FAF761D07", "target": "Granaio IV" },
    { "gameKey": "MJIText#70", "hash": "CFEB8C1E9CBBA836", "target": "Granaio V" },
    { "gameKey": "MJIText#71", "hash": "56B6F3239C777BA8", "target": "Grotte Fatiscenti" },
    { "gameKey": "MJIText#72", "hash": "CEAF047C80BC6549", "target": "Una struttura all'avanguardia, pensata appositamente per agevolare il lavoro dei mammets raccoglitori più esperti." },
    { "gameKey": "MJIText#73", "hash": "E34923BFB8077B50", "target": "Casetta Accogliente IV" },
    { "gameKey": "MJIText#74", "hash": "D44F933ADFA3E422", "target": "Un'elegante dimostrazione del successo e della prosperità della tua attività sull'isola, dalla prua al robusto secondo piano." },
    { "gameKey": "MJIText#75", "hash": "9C53900D7BEBD707", "target": "Officina IV" },
    { "gameKey": "MJIText#76", "hash": "A7C8FD86454CA7CD", "target": "Una struttura funzionale progettata per migliorare l'efficienza già notevole dei mammets artigiani veterani." },
    { "gameKey": "MJIText#77", "hash": "827033EE4A4815CB", "target": "Mattone Piastrellato" },
    { "gameKey": "MJIText#78", "hash": "D59943700F30A8B6", "target": "Mattone Piastrellato" },
    { "gameKey": "MJIText#79", "hash": "9CB2155A264A5D5D", "target": "Mattone Piastrellato" },
    { "gameKey": "MJIText#80", "hash": "7A147D2632E1E40F", "target": "Rotta Inesplorata" },
    { "gameKey": "MJIText#81", "hash": "DC30DA8AEACEE975", "target": "Quella che era una fregata è diventata un parco giochi. I mammets dell'isola la adorano." },
    { "gameKey": "MJIText#82", "hash": "F9AF7658A98306C6", "target": "Torre dell'Orologio Pittoresca" },
    { "gameKey": "MJIText#83", "hash": "3584B61724386BE2", "target": "Un segnatempo tranquillo, completo di pendolo che oscilla lentamente. Amato dai mammets dell'isola." },
    { "gameKey": "MJIText#84", "hash": "A8937C7A9DACC32D", "target": "Ambizione del Custode dell'Isola" },
    { "gameKey": "MJIText#85", "hash": "D93C84269768B121", "target": "Panorama del Custode dell'Isola" },
    { "gameKey": "MJIText#86", "hash": "6D996FDB7BBE0FA0", "target": "Un grande deposito utilizzato esclusivamente dai mammets raccoglitori più esperti." },
    { "gameKey": "MJIText#87", "hash": "31161AE1AD709271", "target": "Casetta Accogliente V" },
    { "gameKey": "MJIText#88", "hash": "76AA8BBD8A314D5C", "target": "Una testimonianza opulenta dei frutti delle attività sull'isola." },
    { "gameKey": "MJIText#89", "hash": "2BC1B8F6B4455A9F", "target": "Officina V" },
    { "gameKey": "MJIText#90", "hash": "73105B9BEAA2CB92", "target": "Un luogo di lavoro imponente, dotato di strutture adatte alle mani esperte dei mammets artigiani più qualificati." },
    { "gameKey": "MJIText#91", "hash": "593E20062E6AEB13", "target": "Albero Etereo" },
    { "gameKey": "MJIText#92", "hash": "5FA57A856F3BBC09", "target": "Un'insolita fusione tra albero e cristallo che sprigiona potenti energie eteree. Amato dai mammets dell'isola." },
    { "gameKey": "MJIText#93", "hash": "75E49F41459E85C2", "target": "Rifugio nel Rifugio" },
    { "gameKey": "MJIText#94", "hash": "77C7B57A249D7099", "target": "Ideato da mammets in cerca di un rifugio all'interno di un santuario che non è il loro. Amato dai mammets dell'isola." },
    { "gameKey": "MJIText#95", "hash": "B2A8745FA912D87D", "target": "Mattone Rosso" },
    { "gameKey": "MJIText#96", "hash": "A0CADAAD656163C5", "target": "Mattone Rosso" },
