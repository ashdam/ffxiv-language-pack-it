  "entries": [
    { "gameKey": "ChocoboRaceItem#0.0", "hash": "A28C7CD016076D3B", "target": "Vuoto" },
    { "gameKey": "ChocoboRaceItem#0.1", "hash": "7574D2CF4A8CECC2", "target": "Il tuo chocobo non ha con sé oggetti da gara.<br>Apri uno scrigno lungo il percorso per ottenerne uno." },
    { "gameKey": "ChocoboRaceItem#1.0", "hash": "9DEBAAD85F6D162B", "target": "Choco Pozione" },
    { "gameKey": "ChocoboRaceItem#1.1", "hash": "EDB205ACA182101F", "target": "Ripristina istantaneamente il 10% del vigore." },
    { "gameKey": "ChocoboRaceItem#2.0", "hash": "32E6B1F3D4CC4EA0", "target": "Compressa del Vigore" },
    { "gameKey": "ChocoboRaceItem#2.1", "hash": "5661B9FB9BCE831D", "target": "Impedisce la riduzione del vigore per 10 secondi. Se il vigore è a zero, ne ripristina una piccola quantità." },
    { "gameKey": "ChocoboRaceItem#3.0", "hash": "51836A90513AF566", "target": "Scarpe da Sprint" },
    { "gameKey": "ChocoboRaceItem#3.1", "hash": "69C719105E97E6B0", "target": "Conferisce un'improvvisa accelerazione." },
    { "gameKey": "ChocoboRaceItem#4.0", "hash": "5D17885469B4C429", "target": "Choco Etere" },
    { "gameKey": "ChocoboRaceItem#4.1", "hash": "E57EBCAAB7433A4C", "target": "Consente di usare di nuovo un'abilità di gara già utilizzata." },
    { "gameKey": "ChocoboRaceItem#5.0", "hash": "1756F4D0347DF6D6", "target": "Acqua di Bacco" },
    { "gameKey": "ChocoboRaceItem#5.1", "hash": "0DCD78E54D053515", "target": "Infligge lo stato Frenetico al chocobo che ti precede." },
    { "gameKey": "ChocoboRaceItem#6.0", "hash": "CF92434FFC953723", "target": "Palla Gravitazionale" },
    { "gameKey": "ChocoboRaceItem#6.1", "hash": "7D6957E43A88E456", "target": "Infligge Pesantezza al chocobo che ti precede." },
    { "gameKey": "ChocoboRaceItem#7.0", "hash": "3090EF99F81E69D6", "target": "Tribolo di Rovo" },
    { "gameKey": "ChocoboRaceItem#7.1", "hash": "D006B826B0B44F8C", "target": "Circonda il tuo chocobo con un anello di spine che sottrae vigore a ogni chocobo che vi entra." },
    { "gameKey": "ChocoboRaceItem#8.0", "hash": "B17249E2990F3BFA", "target": "Tonico dell'Eroe" },
    { "gameKey": "ChocoboRaceItem#8.1", "hash": "BD3BE50D7FE1ACC7", "target": "Rinvigorisce il tuo chocobo per 15 secondi, migliorandone le prestazioni e annullando ogni alterazione negativa." },
    { "gameKey": "ChocoboRaceItem#9.0", "hash": "5FB6FAA92A12E001", "target": "Choco Meteora" },
    { "gameKey": "ChocoboRaceItem#9.1", "hash": "467D26FF5F9EBAA5", "target": "Evoca una meteora dal cielo per devastare tutti gli altri chocobo." },
    { "gameKey": "ChocoboRaceItem#10.0", "hash": "A77FC9A8B3D32442", "target": "Scambio di Vigore" },
    { "gameKey": "ChocoboRaceItem#10.1", "hash": "84EA2B2FABCEF392", "target": "Scambia il vigore del tuo chocobo con quello di un chocobo che ti precede. Lo scambio avviene solo se l'altro ha più vigore del tuo." },
    { "gameKey": "ChocoboRaceItem#11.0", "hash": "C2897805993BE2DC", "target": "Ragnatela" },
    { "gameKey": "ChocoboRaceItem#11.1", "hash": "E958360FCC0DF29A", "target": "Impedisce al chocobo immediatamente dietro di te di usare oggetti." }
  ]
}
