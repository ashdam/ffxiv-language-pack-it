{
  "sheet": "MKDSupportJob",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "MKDSupportJob#0.0", "hash": "4BBA88EAFD0DFFBE", "target": "Tuttofare Fantasma" },
    { "gameKey": "MKDSupportJob#0.1", "hash": "76F611C565F60298", "target": "Tuttofare F." },
    { "gameKey": "MKDSupportJob#0.3", "hash": "3953277178CB9660", "target": "Le reminiscenze di viaggi appena iniziati e di altri conclusi da tempo racchiudono le numerose tecniche di supporto del tuttofare." },
    { "gameKey": "MKDSupportJob#0.4", "hash": "412B1D804A96C865", "target": "Phantom Freelancer" },
    { "gameKey": "MKDSupportJob#1.0", "hash": "C30351012BBD5294", "target": "Cavaliere Fantasma" },
    { "gameKey": "MKDSupportJob#1.1", "hash": "B7742C3F6F6062BA", "target": "Cavaliere F." },
    { "gameKey": "MKDSupportJob#1.3", "hash": "CB4EAD52D55681A1", "target": "Emula questi antichi ricordi di un cavaliere leale e onorevole e difendi i tuoi compagni dai pericoli." },
    { "gameKey": "MKDSupportJob#1.4", "hash": "17736741DE595AC3", "target": "Phantom Knight" },
    { "gameKey": "MKDSupportJob#2.0", "hash": "8A42DD63A3ACF012", "target": "Berserker Fantasma" },
    { "gameKey": "MKDSupportJob#2.1", "hash": "01CD0B177F6F1679", "target": "Berserker F." },
    { "gameKey": "MKDSupportJob#2.3", "hash": "E669094F2B1A4CD3", "target": "La ferocia e il coraggio incrollabile caratterizzano i ricordi di questo antico berserker. Le sue tecniche comportano grandi rischi e ricompense ancora maggiori." },
    { "gameKey": "MKDSupportJob#2.4", "hash": "6ECCC42B7579E461", "target": "Phantom Berserker" },
    { "gameKey": "MKDSupportJob#3.0", "hash": "C2D12FB2C9B6A31B", "target": "Monaco Fantasma" },
    { "gameKey": "MKDSupportJob#3.1", "hash": "C21E1151B4A1B77E", "target": "Monaco F." },
    { "gameKey": "MKDSupportJob#3.3", "hash": "E417CA80B42BF051", "target": "Questi ricordi della disciplina incrollabile e della quieta meditazione di un monaco offrono un cammino verso una padronanza del combattimento senza pari." },
    { "gameKey": "MKDSupportJob#3.4", "hash": "6051667EAF00102B", "target": "Phantom Monk" },
    { "gameKey": "MKDSupportJob#4.0", "hash": "065E7EE7FD1AA355", "target": "Cacciatore Fantasma" },
    { "gameKey": "MKDSupportJob#4.1", "hash": "DA40B205203EED50", "target": "Cacciatore F." },
    { "gameKey": "MKDSupportJob#4.3", "hash": "A8D4B3F06ADAF857", "target": "Incanala questi ricordi di un cacciatore fiero e appassionato e impara a richiamare le forze della natura in battaglia." },
    { "gameKey": "MKDSupportJob#4.4", "hash": "83A1E8B0063A048F", "target": "Phantom Ranger" },
    { "gameKey": "MKDSupportJob#5.0", "hash": "C1202425AB9661AB", "target": "Samurai Fantasma" },
    { "gameKey": "MKDSupportJob#5.1", "hash": "0CB15F0D72E73D90", "target": "Samurai F." },
    { "gameKey": "MKDSupportJob#5.3", "hash": "AAEC0E4F6CD5B280", "target": "L'addestramento rigoroso e un severo codice cavalleresco caratterizzano questi ricordi di un antico samurai. Attingi a essi per abbattere i nemici con un solo colpo letale." },
    { "gameKey": "MKDSupportJob#5.4", "hash": "FE05F616139A5E46", "target": "Phantom Samurai" },
    { "gameKey": "MKDSupportJob#6.0", "hash": "589CD9793E04FCCF", "target": "Bardo Fantasma" },
    { "gameKey": "MKDSupportJob#6.1", "hash": "84B332711BFCCE26", "target": "Bardo F." },
    { "gameKey": "MKDSupportJob#6.3", "hash": "4AEE4A89EAF12ED2", "target": "Questi ricordi riecheggiano delle immagini vivide del canto melodioso di un bardo. Usali per intonare le stesse ballate in battaglia." },
    { "gameKey": "MKDSupportJob#6.4", "hash": "678FD76402DFA2FD", "target": "Phantom Bard" },
    { "gameKey": "MKDSupportJob#7.0", "hash": "59D75D44C52FCB24", "target": "Geomante Fantasma" },
    { "gameKey": "MKDSupportJob#7.1", "hash": "B74B3ED77A609765", "target": "Geomante F." },
    { "gameKey": "MKDSupportJob#7.3", "hash": "9CA0BD2D2881BBBC", "target": "I ricordi di questo geomante traboccano di una comprensione sconfinata delle leggi naturali. Attingi a essi per usare tecniche che dipendono dal tempo atmosferico." },
    { "gameKey": "MKDSupportJob#7.4", "hash": "B35CECE4CF63F8D8", "target": "Phantom Geomancer" },
    { "gameKey": "MKDSupportJob#8.0", "hash": "831F8E32CA8D8E00", "target": "Cronomago Fantasma" },
    { "gameKey": "MKDSupportJob#8.1", "hash": "0EFB1F2F9815D989", "target": "Cronomago F." },
    { "gameKey": "MKDSupportJob#8.3", "hash": "EC6B14041C7FED64", "target": "I ricordi di questo antico cronomago rivelano molto sulle leggi del tempo e su come manipolarle a proprio vantaggio." },
    { "gameKey": "MKDSupportJob#8.4", "hash": "67933EE6C17A84FF", "target": "Phantom Time Mage" },
    { "gameKey": "MKDSupportJob#9.0", "hash": "CEC9A57C7236801F", "target": "Artigliere Fantasma" },
    { "gameKey": "MKDSupportJob#9.1", "hash": "50DCC7A7B0DB6A78", "target": "Artigliere F." },
    { "gameKey": "MKDSupportJob#9.3", "hash": "50996DEA327C7143", "target": "Una padronanza teorica e pratica della balistica pervade i ricordi di questo artigliere. Emulali per bombardare i nemici con potenti proiettili." },
    { "gameKey": "MKDSupportJob#9.4", "hash": "7B88AE375932635D", "target": "Phantom Cannoneer" },
    { "gameKey": "MKDSupportJob#10.0", "hash": "EB96F82B0BEA7553", "target": "Alchimista Fantasma" },
    { "gameKey": "MKDSupportJob#10.1", "hash": "8A4AFCEF656A7A43", "target": "Alchimista F." },
    { "gameKey": "MKDSupportJob#10.3", "hash": "AEC479FDD0A03016", "target": "I ricordi di questo alchimista offrono conoscenze sulle antiche teorie medicinali, comprese tecniche curative che volgeranno senz'altro le sorti della battaglia a tuo favore." },
    { "gameKey": "MKDSupportJob#10.4", "hash": "D3FC862A930971C4", "target": "Phantom Chemist" },
    { "gameKey": "MKDSupportJob#11.0", "hash": "87E4C2A262E3EA1C", "target": "Oracolo Fantasma" },
    { "gameKey": "MKDSupportJob#11.1", "hash": "C150467564E3CA95", "target": "Oracolo F." },
    { "gameKey": "MKDSupportJob#11.3", "hash": "E643C03BA734F9E9", "target": "Dotati dei sensi soprannaturali e delle intuizioni profetiche di un oracolo, questi ricordi promettono la padronanza di numerose abilità di supporto." },
    { "gameKey": "MKDSupportJob#11.4", "hash": "82DE7552F738268E", "target": "Phantom Oracle" },
    { "gameKey": "MKDSupportJob#12.0", "hash": "0E505003A09E9C8C", "target": "Ladro Fantasma" },
    { "gameKey": "MKDSupportJob#12.1", "hash": "7062667C38345050", "target": "Ladro F." },
    { "gameKey": "MKDSupportJob#12.3", "hash": "82D4D91A9FF89098", "target": "Questi ricordi di un ladro abile e dai saldi principi offrono tecniche di sopravvivenza che si riveleranno senz'altro utili sull'isola." },
    { "gameKey": "MKDSupportJob#12.4", "hash": "D98643AC83B63A4B", "target": "Phantom Thief" },
    { "gameKey": "MKDSupportJob#13.0", "hash": "580BE9E28DEDF63F", "target": "Paladino Fantasma" },
    { "gameKey": "MKDSupportJob#13.1", "hash": "C96DC7260A5B8906", "target": "Paladino F." },
    { "gameKey": "MKDSupportJob#13.3", "hash": "F574493F67998A4E", "target": "Permeati dalla dedizione e dall'abilità arcana di un paladino, questi ricordi sono la chiave per infondere potenti magie nelle tue armi." },
    { "gameKey": "MKDSupportJob#13.4", "hash": "DFE8A9B1362DC23C", "target": "Phantom Mystic Knight" },
    { "gameKey": "MKDSupportJob#14.0", "hash": "C02E96D721E11BF4", "target": "Gladiatore Fantasma" },
    { "gameKey": "MKDSupportJob#14.1", "hash": "6F1EEEE07DB9D981", "target": "Gladiatore F." },
    { "gameKey": "MKDSupportJob#14.3", "hash": "683446439DBC4214", "target": "I ricordi di questo gladiatore feroce e indomabile promettono la padronanza di numerose abilità offensive e difensive." },
    { "gameKey": "MKDSupportJob#14.4", "hash": "BC54C9F41DB74D02", "target": "Phantom Gladiator" },
    { "gameKey": "MKDSupportJob#15.0", "hash": "B09D27343AEBC7E1", "target": "Danzatore Fantasma" },
    { "gameKey": "MKDSupportJob#15.1", "hash": "1582410AA34A561E", "target": "Danzatore F." },
    { "gameKey": "MKDSupportJob#15.3", "hash": "D69F7B825DC00C36", "target": "Assorbi i ricordi di un danzatore eccelso ed espressivo per replicarne gli agili passi e ricevere una serie di benefici." },
    { "gameKey": "MKDSupportJob#15.4", "hash": "D20C5321D6BD6B1A", "target": "Phantom Dancer" },
    { "gameKey": "MKDSupportJob#16.0", "hash": "06B2B0A5C99F2DBD", "target": "Ninja Fantasma" },
    { "gameKey": "MKDSupportJob#16.1", "hash": "8F56E876FC401C4F", "target": "Ninja F." },
    { "gameKey": "MKDSupportJob#16.3", "hash": "9B8B077ECB331126", "target": "Questi ricordi della furtività e dell'immobilità di un ninja si riveleranno utili in molte situazioni precarie." },
    { "gameKey": "MKDSupportJob#16.4", "hash": "E919C3298694CC35", "target": "Phantom Ninja" },
    { "gameKey": "MKDSupportJob#17.0", "hash": "5BC2270F54F27FFF", "target": "Mago Bianco Fantasma" },
    { "gameKey": "MKDSupportJob#17.1", "hash": "4D9EC77ECD475A41", "target": "Mago Bianco F." },
    { "gameKey": "MKDSupportJob#17.3", "hash": "EE540B6859FF054A", "target": "Padroneggia le tecniche curative grazie ai rasserenanti ricordi di un devoto mago bianco." },
    { "gameKey": "MKDSupportJob#17.4", "hash": "117C41EC028D1088", "target": "Phantom White Mage" },
    { "gameKey": "MKDSupportJob#18.0", "hash": "B55880FFAF6CDBB3", "target": "Mago Nero Fantasma" },
    { "gameKey": "MKDSupportJob#18.1", "hash": "060A666F2F67EF1B", "target": "Mago Nero F." },
    { "gameKey": "MKDSupportJob#18.3", "hash": "C86FDA97E5196C90", "target": "Permeati dalle assidue ricerche e sperimentazioni di un mago nero, questi ricordi ti conferiranno l'arte arcana della distruzione." },
    { "gameKey": "MKDSupportJob#18.4", "hash": "43693A42F118A904", "target": "Phantom Black Mage" },
    { "gameKey": "MKDSupportJob#19.0", "hash": "E12C161BABF06A4B", "target": "Dragone Fantasma" },
    { "gameKey": "MKDSupportJob#19.1", "hash": "44CEDF3B21385198", "target": "Dragone F." },
    { "gameKey": "MKDSupportJob#19.3", "hash": "EF9EFF2C6C3E6508", "target": "I ricordi dei viaggi di un dragone esperto ti insegneranno ad affondare e trafiggere senza subire conseguenze." },
    { "gameKey": "MKDSupportJob#19.4", "hash": "29A845E91EC643D0", "target": "Phantom Dragoon" },
    { "gameKey": "MKDSupportJob#20.0", "hash": "CAA854A5D2DDF058", "target": "Evocatore Fantasma" },
    { "gameKey": "MKDSupportJob#20.1", "hash": "5634B4CB24388E2F", "target": "Evocatore F." },
    { "gameKey": "MKDSupportJob#20.3", "hash": "3385F14B21EA5D19", "target": "Incanala le reminiscenze di un evocatore colto ed esperto e impara a richiamare potenti creature versate sia nell'attacco sia nella difesa." },
    { "gameKey": "MKDSupportJob#20.4", "hash": "73CE0E0896122F2C", "target": "Phantom Summoner" },
    { "gameKey": "MKDSupportJob#21.0", "hash": "5CCD5CC7B3E6F47A", "target": "Mago Blu Fantasma" },
    { "gameKey": "MKDSupportJob#21.1", "hash": "30F3F4C56BC1AB83", "target": "Mago Blu F." },
    { "gameKey": "MKDSupportJob#21.3", "hash": "9620855D71CD7A69", "target": "I ricordi di questo stregone disilluso sono intrisi di profonda paranoia. Attingi a essi per ottenere un potere mostruoso in forma arcana." },
    { "gameKey": "MKDSupportJob#21.4", "hash": "B9F232A4A3E2C154", "target": "Phantom Blue Mage" },
    { "gameKey": "MKDSupportJob#22.0", "hash": "CF9AC10BF9144C53", "target": "Mago Rosso Fantasma" },
    { "gameKey": "MKDSupportJob#22.1", "hash": "D635707728341CB4", "target": "Mago Rosso F." },
    { "gameKey": "MKDSupportJob#22.3", "hash": "18FA63CFE418CB82", "target": "Questi ricordi di un arguto mago rosso errante ti permetteranno di usare la magia nera e quella bianca in perfetto equilibrio." },
    { "gameKey": "MKDSupportJob#22.4", "hash": "6A0D9809BA858A47", "target": "Phantom Red Mage" },
    { "gameKey": "MKDSupportJob#23.0", "hash": "1E9E4CD0C908D103", "target": "Necromante Fantasma" },
    { "gameKey": "MKDSupportJob#23.1", "hash": "82C92D9A2376B333", "target": "Necromante F." },
    { "gameKey": "MKDSupportJob#23.3", "hash": "01DC065F9E320F23", "target": "Impregnati dell'ostinazione di un necromante profanato, questi ricordi promettono il potere di combattere oltre la morte." },
    { "gameKey": "MKDSupportJob#23.4", "hash": "B460ADB08BA7DE76", "target": "Phantom Necromancer" }
  ]
}
