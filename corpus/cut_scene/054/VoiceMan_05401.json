{
  "conversation": "cut_scene/054/VoiceMan_05401",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000010_GAIA", "hash": "378E3D05CFEFB796", "target": "Sto estraendo le Tenebre. Preparati!" },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000020_RYNE", "hash": "4364868516E1DAAD", "target": "Ha funzionato, Gaia! Ce l'abbiamo fatta!" },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000030_RYNE", "hash": "906AFEB60AA631C4", "target": "Quindi è successo tutto cent'anni fa..." },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000040_RYNE", "hash": "8A66BE3D0ECDCE21", "target": "Ma cosa c'entra con Gaia?" },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000050_RYNE", "hash": "BB2E501B4A50ECBA", "target": "Conosco questo posto...! È la prigione di Eulmore!" },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000060_RYNE", "hash": "110276C3593B06E0", "target": "Qualunque cosa ci ostacoli..." },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000070_RYNE", "hash": "19366ED8C2C40ADC", "target": "...non perderemo mai la speranza!" },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000080_EDEN3BOSS3", "hash": "C5A6CB59793DA188", "target": "Merita... tutta la felicità... del mondo..." },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000090_EDEN3BOSS4", "hash": "7534593E01460C5B", "target": "Eden diventerà un'utopia..." },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000100_EDEN3BOSS4", "hash": "991BA113F7B501E2", "target": "Che condivideremo per tutta l'eternità." },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000110_RYNE", "hash": "BDF0C57278417B5D", "target": "È ancora lì dentro, da qualche parte..." },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000120_RYNE", "hash": "DE791688CA0EFF4B", "target": "Non rinuncerò al nostro futuro, Gaia! Qualunque cosa accada!" },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000130_EDEN3BOSS4", "hash": "447FE07482C27677", "target": "La nostra utopia... Il nostro sogno!" },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000140_EDEN3BOSS5", "hash": "77C4DB2BDCFB9420", "target": "Io... tornerò..." }
  ]
}
