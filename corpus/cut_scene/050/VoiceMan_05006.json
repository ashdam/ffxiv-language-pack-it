  "entries": [
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000001_OLDTITANIA", "hash": "C563DA51EB6B0615", "target": "Chi va là? Sei tu ad aver infranto il sigillo?" },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000002_OLDTITANIA", "hash": "6F06D40A3ADCA366", "target": "Ah, tanto tempo perduto... Tanti giochi e banchetti mai goduti..." },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000003_OLDTITANIA", "hash": "0A5521D2E22C6AAA", "target": "Dobbiamo recuperare, dobbiamo... Cominciando col giocare con <italic(1)>te<italic(0)>!" },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000010_OLDTITANIA", "hash": "F6750105EA33FFB6", "target": "Non possiamo più... giocare..." },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000110_VAUTHRY", "hash": "BD6CF9EB7F3ED4EC", "target": "Siete tanto decisi a morire? Un'ultima possibilità, malvagi: inchinatevi e riconoscete il vostro re. Il vostro dio!" },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000120_VAUTHRY", "hash": "1BB2136161BB98A7", "target": "Ma... io sono onnipotente..." },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000210_EMETSELCH", "hash": "3164D5E59540FB73", "target": "Mostratemi la vostra «decantata» forza. E io svelerò la menzogna della vostra esistenza frammentata!" },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000220_EMETSELCH", "hash": "04BF5A9209AB3A78", "target": "Tu... tu non hai alcun potere su di me!" }
  ]
}
