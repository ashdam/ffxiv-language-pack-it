    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_TEST_ENTER_MATCHING_Q", "hash": "D82C38775795779F", "target": "Vuoi davvero entrare con un gruppo abbinato?" },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_WOODWAILERCAPTAIN01556_000_050", "hash": "3B6A6705C2A6BF06", "target": "Vorresti entrare nelle rovine senza compagnia!? La magia di quel luogo ti indebolirà, e avrai soltanto le armi aetherpool dei Padjal ad aiutarti. Persino quelle potrebbero non bastare senza potenziamenti." },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_TEST_ENTER_SOLO", "hash": "961F8DEAF4AE1813", "target": "Vuoi davvero entrare senza compagnia?" },
