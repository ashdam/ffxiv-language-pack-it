  "entries": [
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_WOODWAILERCAPTAIN01556_000_000", "hash": "D014ACE05AE92DA2", "target": "Una grave minaccia alla pace del Sudario si è manifestata, e mi hanno inviato ad aiutare a scacciarla. Avventurieri o meno, non permetterò a nessuno di intralciare il mio lavoro. Ora, per favore, prosegui." },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_WOODWAILERCAPTAIN01556_000_020", "hash": "94081C319CE22A63", "target": "Per fortuna il curatore di quel luogo maledetto è stato tanto sbadato da lasciare i suoi appunti dove potevamo trovarli. Forse ora scopriremo le sue vere intenzioni." },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_TEST_START_MENU_ENTER", "hash": "0E9F6E2B592A8D03", "target": "Entrare nel Palace of the Dead" },
