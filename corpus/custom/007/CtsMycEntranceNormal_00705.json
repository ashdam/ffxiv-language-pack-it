    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_A4_000_005", "hash": "4AF32DFC789AB94C", "target": "Niente." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_MIKOTO_000_100", "hash": "D1927F35CE34C860", "target": "Se solo ricordassi che cosa mi ha fatto Misija. Ricordo uno strano dispositivo ed ero legata, ma purtroppo tutto il resto è confuso..." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_MIKOTO_000_101", "hash": "D1258769392B376E", "target": "Se è disposta a spingersi tanto oltre pur di impadronirsi di quelle rovine, può significare solo una cosa: al loro interno dev’esserci una scorta di cristalli capace di alimentare Save the Queen." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_MIKOTO_000_102", "hash": "38DE4AC6549E88E2", "target": "Vi prego, dovete fermarla! Se dovesse liberare tutta la potenza della lama, ogni speranza sarebbe perduta!" }
