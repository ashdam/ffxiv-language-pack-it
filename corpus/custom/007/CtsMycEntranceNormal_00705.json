    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_SERAOUSH_000_000", "hash": "F434B14FAA53ED7E", "target": "Oserei dire che non c’è soldato in tutta la Resistenza che non abbia sentito parlare delle vostre imprese sul fronte meridionale." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_SYSTEM_000_001", "hash": "6205734ACCF6D048", "target": "Il tuo rango della Resistenza è <num(lnum1)> e hai accumulato <kilo(lnum2,\\,)> mettle." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_SYSTEM_000_005", "hash": "79FF7C34D841FF29", "target": "Hai raggiunto il rango massimo della Resistenza." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_SYSTEM_000_010", "hash": "27480C3D906783F2", "target": "Per raggiungere il rango successivo della Resistenza occorrono <kilo(lnum1,\\,)> mettle." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_SYSTEM_000_015", "hash": "E96A4DDEDC562C48", "target": "Hai accumulato abbastanza mettle per aumentare il tuo rango della Resistenza. Fai rapporto al comandante della Resistenza al Bozjan Southern Front." },
