{
  "conversation": "custom/007/CtsMjiEntrance_00798",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_BARDIN_000_000", "hash": "3D06F797198F019B", "target": "Ehilà, <if(gnum4,ragazza,ragazzo)>. Dove ti porto?" },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_000_020", "hash": "993BE6DCD5FF5AC7", "target": "Devi tornare nel tuo mondo di origine per raggiungere la tua isola personale." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_000_000", "hash": "9001FF9D67685FF6", "target": "Cosa vuoi fare?" },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_000_005", "hash": "BCDE85DBB5B07F5E", "target": "Raggiungere la tua isola?" },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_000_010", "hash": "85A5EA89029892CB", "target": "Che tipo di conoscente?" },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_000_015", "hash": "499D436C2379EF57", "target": "Cosa vuoi chiedere?" },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q1_000_000", "hash": "264B296B9D81AFC4", "target": "Vai alla tua isola." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q1_000_005", "hash": "03B7445ABEB84BE3", "target": "Vai all'isola di un conoscente." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q1_000_010", "hash": "D812E7AFD733BF96", "target": "Saperne di più." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q1_000_015", "hash": "E05B8B330D14F7AA", "target": "Niente." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q2_000_000", "hash": "3631EBAB3EE585C8", "target": "Informati sulla tua isola." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q2_000_005", "hash": "458B074F50629AB0", "target": "Informati sulla tua isola." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q2_000_010", "hash": "7013CBAFF4D69EFD", "target": "Informati sulle isole dei conoscenti." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q2_000_015", "hash": "E1856FA1DA727551", "target": "Niente." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q3_000_000", "hash": "EFFCAEB962945FEB", "target": "Un amico." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q3_000_005", "hash": "403BA90E3B6BD1AC", "target": "Un membro della mia Free Company." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q3_000_010", "hash": "BFD1F1A1562EE085", "target": "Un membro del gruppo." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q3_000_015", "hash": "A9F582348D6A6FFB", "target": "Lascia perdere." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_BARDIN_100_000", "hash": "5371ABFE572E31EC", "target": "Mi chiedi della tua dannata isola? Mi stai prendendo in giro. \\<sospiro> Spero che quel progettino di Tataru ti stia andando bene." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_BARDIN_200_000", "hash": "6FAEE783162A48EE", "target": "Vuoi sapere cosa puoi fare sulla tua isola, eh? Beh, quello che ti pare, è proprio questo il punto. Allestisci un piccolo pascolo per gli animali, coltiva qualcosa o esplora e basta. Sta a te. Se ne vuoi una tutta tua, ti serviranno gli agganci giusti." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_200_000", "hash": "78E2150E3EB2957F", "target": "Per sbloccare la tua isola personale, devi prima completare la missione dello scenario principale \"Endwalker\" e proseguire nella missione \"Seeking Sanctuary\"." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_200_005", "hash": "54A230D1B548CDB7", "target": "Per sbloccare la tua isola personale, devi prima raggiungere un determinato punto della missione \"Seeking Sanctuary\", disponibile parlando con lo strillone spaesato a Old Sharlayan." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_BARDIN_300_000", "hash": "DFAB85234679858A", "target": "L'Ammiraglio ha concesso ad alcuni avventurieri di coltivare le Cieldalaes, un vasto arcipelago di isole disabitate nel Mare di Rhotano, se non lo sapessi. Conosco quelle acque come le mie tasche, quindi basta una parola e possiamo salpare." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_300_000", "hash": "A70E44F008B23EAB", "target": "Puoi visitare l'isola di un membro del gruppo, di un membro della Free Company o di un amico che abbia sbloccato questa funzione." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_300_005", "hash": "E19AA19B08B9DF4F", "target": "Non puoi visitare un'isola se chi la possiede ne ha vietato l'accesso, se non c'è nessuno sull'isola o se è già stata raggiunta la capienza massima." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_300_010", "hash": "4DB795307AA2B389", "target": "Inoltre, per visitare l'isola di un conoscente, devi trovarti nel suo mondo di origine." }
  ]
}
