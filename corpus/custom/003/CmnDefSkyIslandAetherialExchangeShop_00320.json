    { "gameKey": "custom/003/CmnDefSkyIslandAetherialExchangeShop_00320#TEXT_CMNDEFSKYISLANDAETHERIALEXCHANGESHOP_00320_A8", "hash": "FC31CBABB524BB18", "target": "Annulla" },
    { "gameKey": "custom/003/CmnDefSkyIslandAetherialExchangeShop_00320#TEXT_CMNDEFSKYISLANDAETHERIALEXCHANGESHOP_00320_001", "hash": "AEAF8DD583F464AF", "target": "Vi prego di non badare a me, <if(gnum4,signorina,signore)>. Mi occupo soltanto di acquistare l'equipaggiamento indesiderato che gli avventurieri si procurano nel Diadem." },
    { "gameKey": "custom/003/CmnDefSkyIslandAetherialExchangeShop_00320#TEXT_CMNDEFSKYISLANDAETHERIALEXCHANGESHOP_00320_011", "hash": "A76090BFD288D4E6", "target": "Chiedo scusa, <if(gnum4,signorina,signore)>, ma per caso avete dell'equipaggiamento del Diadem? No? Beh, se doveste trovarne, sappiate che lo acquisterò volentieri." },
    { "gameKey": "custom/003/CmnDefSkyIslandAetherialExchangeShop_00320#TEXT_CMNDEFSKYISLANDAETHERIALEXCHANGESHOP_00320_021", "hash": "40C9E8808AF486E8", "target": "Non avrete mica con voi qualche gingillo del Diadem, vero? Lo immaginavo. Se conoscete qualcuno che ne ha, ditegli che ne compro, d'accordo?" },
    { "gameKey": "custom/003/CmnDefSkyIslandAetherialExchangeShop_00320#TEXT_CMNDEFSKYISLANDAETHERIALEXCHANGESHOP_00320_031", "hash": "442B1A935DEBDBF4", "target": "Avete l'aria di chi ama l'avventura. Se per caso i vostri viaggi vi portassero nel Diadem, potreste imbattervi in un certo tipo di equipaggiamento: lo riconoscerete quando lo vedrete, credetemi. Portatelo qui e vi ricompenserò come si deve." },
    { "gameKey": "custom/003/CmnDefSkyIslandAetherialExchangeShop_00320#TEXT_CMNDEFSKYISLANDAETHERIALEXCHANGESHOP_00320_041", "hash": "CFC204E77A397F5A", "target": "Salve a voi, <if(gnum4,signora,signore)>. Colleziono equipaggiamento raro, in particolare quello del Diadem. Se mi portate articoli del genere, vi offrirò un compenso adeguato." }
