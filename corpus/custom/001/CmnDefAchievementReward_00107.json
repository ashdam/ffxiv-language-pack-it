    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A4_08", "hash": "5462FDC87EABB989", "target": "<sheet(AchievementKind,11,0)>." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A4_09", "hash": "FAF3409A9D44499E", "target": "<sheet(AchievementKind,12,0)>." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A4_10", "hash": "B7105CE8118271C5", "target": "Annulla" },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_SYSTEM_000_041", "hash": "CFB4BFE092B1FC6D", "target": "Puoi ritirare le ricompense anche direttamente dal menu Achievements, sotto Character nel menu principale." }
