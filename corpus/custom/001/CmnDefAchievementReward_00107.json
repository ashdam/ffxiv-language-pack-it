{
  "conversation": "custom/001/CmnDefAchievementReward_00107",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_JONATHAS_000_001", "hash": "2B976CE8D4508355", "target": "Salve, <if(gnum4,ragazza mia,ragazzo mio)>. Che gentile a fare un po' di compagnia a un vecchio rimbambito come me. Dimmi, ti piacciono le storie? Io adoro una bella storia, soprattutto se è vera e raccontata da chi l'ha vissuta. Se ne hai da condividere, sono tutt'orecchi." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_Q1_01", "hash": "DA892CFD8F01B999", "target": "Cosa vuoi fare?" },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A1_01", "hash": "5D2F2458E450CBCC", "target": "Ricevere la ricompensa per gli obiettivi." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A1_02", "hash": "5E225F3E99C67EA7", "target": "Informati su Jonathas." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A1_03", "hash": "A2D205B55D3A00A4", "target": "Niente." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A1_04", "hash": "D8FD83291FF541EB", "target": "Scambia un achievement certificate." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_JONATHAS_000_010", "hash": "3A960A4939A78579", "target": "Da giovane ebbi l'onore di lavorare come scriba di corte. Ah, i bei tempi, quando avevo ancora la vista acuta e la famiglia reale esercitava un vero potere a Ul'dah." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_JONATHAS_000_011", "hash": "DBD11954C54799AA", "target": "Sembrava non passare giorno senza che il palazzo reale si accendesse di mille colori, tra cerimonie sfarzose e banchetti sontuosi. Oggi, però, niente mi rallegra più delle storie vere di avventure e audaci imprese." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_JONATHAS_000_012", "hash": "F3D23A25CC398658", "target": "Se hai compiuto gesta di cui vai <if(gnum4,fiera,fiero)>, mi farebbe molto piacere sentirtele raccontare. Potrei persino darti qualcosa in cambio." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_SYSTEM_000_013", "hash": "A83E65B686B18198", "target": "Completare determinati obiettivi ti darà diritto a una ricompensa, che potrai ritirare parlando con Jonathas." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_SYSTEM_010_031", "hash": "45B20D68D47AEBCA", "target": "Ogni obiettivo completato conferisce punti obiettivo. Accumulandone una certa quantità, riceverai un achievement certificate." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_JONATHAS_000_030", "hash": "1F7B9CA3E08C6F4C", "target": "Hai compiuto abbastanza gesta da far cantare i bardi per una vita intera, <if(gnum4,ragazza mia,ragazzo mio)>. Imprese simili meritano un riconoscimento, e per questo vorrei che avessi questo. Consideralo un segno della mia più alta stima." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_SYSTEM_000_031", "hash": "116D15C33C0797A6", "target": "I punti obiettivo accumulati ti hanno fatto ottenere un achievement certificate." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_SYSTEM_000_032", "hash": "37347483A0D34E24", "target": "Puoi scambiare i certificati con una ricompensa speciale a tua scelta parlando con Jonathas." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_Q4_01", "hash": "DA640115075B3106", "target": "Seleziona una categoria di obiettivi." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A4_01", "hash": "8CC0BF668FCDC3E5", "target": "<sheet(AchievementKind,1,0)>." },
