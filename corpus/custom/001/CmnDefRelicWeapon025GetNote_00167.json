    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_MENU_PLD_SUB_WEAPON", "hash": "A0F977A5ABE9280D", "target": "Libri sugli scudi." },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_MENU_MAIN_PLD", "hash": "3244B45E981B0315", "target": "Libri del Fuoco (aumentano <sheet(BaseParam,lnum1,1)>). Completati: <num(lnum2)> su <num(lnum3)>" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_MENU_SUB_PLD", "hash": "C6DAD0C895CC1030", "target": "Libri dell'Acqua (aumentano <sheet(BaseParam,lnum1,1)>). Completati: <num(lnum2)> su <num(lnum3)>" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_MENU_SELECTION_A_PLD", "hash": "6734290ABF5E800E", "target": "Libri del Vento (aumentano <sheet(BaseParam,lnum1,1)>). Completati: <num(lnum2)> su <num(lnum3)>" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_MENU_SELECTION_B_PLD", "hash": "12F3D83B75B99413", "target": "Libri della Terra (aumentano <sheet(BaseParam,lnum1,1)>). Completati: <num(lnum2)> su <num(lnum3)>" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_MENU_MAIN_PLD_SUB", "hash": "9F984757A5E04E94", "target": "Libro del Fuoco Infernale (aumenta <sheet(BaseParam,lnum1,1)>). Completati: <num(lnum2)> su <num(lnum3)>" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_MENU_SUB_PLD_SUB", "hash": "B827E13CC940854E", "target": "Libro dell'Acqua Infernale (aumenta <sheet(BaseParam,lnum1,1)>). Completati: <num(lnum2)> su <num(lnum3)>" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_GJUSANA_000_030", "hash": "8E366CB91234A674", "target": "Prima ti ho detto che una serie comprende nove libri, ma esistono anche serie <italic(1)>diverse<italic(0)>. Le ho sfogliate rapidamente e sembra che ciascuna sia dedicata a un'arma specifica. Se hai delle preferenze, fammelo sapere." },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_0000_SYSTEM_000_035", "hash": "EEDFEA5CE33ED36F", "target": "I fatti contano più delle parole. Equipaggia l'arma reliquia atma che desideri potenziare e parla di nuovo con G'jusana." },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_GJUSANA_000_040", "hash": "B8C7E62540C3E2C8", "target": "...Mmm? Pare che abbiamo esaurito tutti i libri su quell'arma. E non c'è da stupirsi, visto che te li sei comprati tutti tu!" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_SYSTEM_000_045", "hash": "D18D6FFDC7F7B450", "target": "Hai già completato tutte le prove per l'arma reliquia atma equipaggiata. Raggiungi Hyrstmill e mostrala a Jalzahn." },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_GJUSANA_000_050", "hash": "92B74490A9ACACD3", "target": "Sembra che tu abbia già letto tutti i libri di questa categoria. Posso interessarti a qualcos'altro?" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_GJUSANA_000_060", "hash": "216AD2071E11DCC4", "target": "Aspetta... Non ti ho <italic(1)>appena<italic(0)> venduto un libro? Per quanto mi piacerebbe dartene un altro, una parte di me pensa che non ti renderei un buon servizio. Mettiamola così: più ne hai, meno li apprezzi!" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_SYSTEM_000_065", "hash": "2EFB953AB91FFE65", "target": "Devi completare tutti gli obiettivi di un libro prima di acquistarne un altro. In alternativa, puoi eliminarlo parlando con G'jusana o tramite il menu Key Items." },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_GJUSANA_000_070", "hash": "A16494D70CCA466F", "target": "Ecco il libro che tanto desideravi. Non dubito che ti regalerà ore e ore di divertimento! Sono mai esistiti 100 <ennoun(Item,3,\u300028,2,1)> spesi meglio? Direi di no!" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_SYSTEM_000_075", "hash": "FCEA2D19483E5F3F", "target": "Hai ottenuto un libro delle Prove dei Prodi. Puoi consultarne gli obiettivi usando l'oggetto nel menu Key Items." },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_NOTE_TRADE_YESNO_Q", "hash": "5A48B4ED91DA27C2", "target": "Scambiare <kilo(lnum3,\\,)> <ennoun(Item,3,lnum2,2,1)> con <ennoun(EventItem,3,lnum1,1,1)>?" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_NOTE_TRADE_YESNO_Q2", "hash": "163907E82CBFF6C9", "target": "L'arma che possiedi non corrisponde ai tuoi progressi nelle prove. Vuoi eliminare <ennoun(EventItem,3,lnum1,1,1)> e acquistare <ennoun(EventItem,3,lnum2,1,1)> per <kilo(lnum4,\\,)> <ennoun(Item,3,lnum3,2,1)>?" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_NOTE_TRADE_YESNO_YES", "hash": "B6A0C7ACE6ED409A", "target": "Sì" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_NOTE_TRADE_YESNO_NO", "hash": "997C5006405F242A", "target": "No" },
    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_GJUSANA_000_080", "hash": "98384A0D272EC202", "target": "Oh, sembra che tu non abbia abbastanza <ennoun(Item,3,\u300028,2,1)>. Temo di non poter scendere sotto i 100 per testi tanto preziosi. Mettiamola così: più fatichi per ottenere qualcosa, più lo apprezzi!" }
  ]
}
