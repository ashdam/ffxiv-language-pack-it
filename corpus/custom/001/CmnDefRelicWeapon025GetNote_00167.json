    { "gameKey": "custom/001/CmnDefRelicWeapon025GetNote_00167#TEXT_CMNDEFRELICWEAPON025GETNOTE_00167_GJUSANA_000_000", "hash": "FB79777DB78D605E", "target": "Immagino tu voglia approfittare della mia offerta speciale? Allora, quale libro delle Prove dei Prodi vuoi acquistare?" },
