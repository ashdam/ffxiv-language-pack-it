    { "gameKey": "custom/002/RegDra2CollectableSupplyFront_00273#TEXT_REGDRA2COLLECTABLESUPPLYFRONT_00273_TALK_A2", "hash": "9A4253D7988DA857", "target": "Come si ottengono i gettoni?" },
    { "gameKey": "custom/002/RegDra2CollectableSupplyFront_00273#TEXT_REGDRA2COLLECTABLESUPPLYFRONT_00273_TALK_A3", "hash": "C2856A50DCB98CA2", "target": "Niente." },
    { "gameKey": "custom/002/RegDra2CollectableSupplyFront_00273#TEXT_REGDRA2COLLECTABLESUPPLYFRONT_00273_GEIMLONA_000_000", "hash": "0E04A09A7348ECC8", "target": "«Meraviglie» è il nome che abbiamo dato agli attrezzi, all'equipaggiamento e agli altri oggetti di qualità che offriamo come incentivo ai nostri fornitori." },
    { "gameKey": "custom/002/RegDra2CollectableSupplyFront_00273#TEXT_REGDRA2COLLECTABLESUPPLYFRONT_00273_GEIMLONA_000_001", "hash": "30BDFE47355D9B71", "target": "Per acquistare questi oggetti vi serviranno dei gettoni... perdonatemi, <italic(1)>Rowena's tokens<italic(0)>. Non accettiamo altre forme di pagamento." },
    { "gameKey": "custom/002/RegDra2CollectableSupplyFront_00273#TEXT_REGDRA2COLLECTABLESUPPLYFRONT_00273_GEIMLONA_000_005", "hash": "D2256CE65A232CF1", "target": "I gettoni necessari vengono emessi in cambio di scrips. I nostri rappresentanti qui possono assistervi subito, se lo desiderate." },
    { "gameKey": "custom/002/RegDra2CollectableSupplyFront_00273#TEXT_REGDRA2COLLECTABLESUPPLYFRONT_00273_GEIMLONA_000_006", "hash": "D5231D110FDEC647", "target": "Naturalmente, se siete a corto di scrips, dovrete portarci altri oggetti collezionabili..." }
  ]
