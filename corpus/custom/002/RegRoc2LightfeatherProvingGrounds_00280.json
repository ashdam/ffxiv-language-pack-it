{
  "conversation": "custom/002/RegRoc2LightfeatherProvingGrounds_00280",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_000", "hash": "54BB88541E2F0C87", "target": "Oh! Salve. Ti do il benvenuto ai Lightfeather Proving Grounds." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_Q1_000_000", "hash": "B9B21FEEC5AE6990", "target": "Cosa vuoi chiedere?" },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_A1_000_001", "hash": "E724A2F89110B3CF", "target": "Informarsi sul lavoro svolto qui." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_A1_000_002", "hash": "14C86A15FAEB94C9", "target": "Che posto è questo?" },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_A1_000_003", "hash": "DB23D9F9D1E667EC", "target": "Niente." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_010", "hash": "6505D000C77B4A56", "target": "Ufficialmente dovrei mostrare il posto ai visitatori e rispondere alle loro domande, ma in pratica non serve quasi mai: qui si vedono di rado facce nuove." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_011", "hash": "C1C912FFFAE41AD2", "target": "Non che mi dispiaccia. Mi piace poter guardare gli incontri in tutta libertà." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_020", "hash": "ADD7DA9D379ABF65", "target": "Come potresti intuire dal nome, i Lightfeather Proving Grounds furono originariamente istituiti per ospitare incontri fra chocobo addestrati al combattimento." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_021", "hash": "39A14D093F8BB0A0", "target": "Da allora, però, la Casata Dzemael ha permesso che l'arena venisse occasionalmente usata anche per altri scopi." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_022", "hash": "7592F5ED27833AD0", "target": "Altre casate vi hanno allestito spettacoli, sia privati sia aperti al pubblico. Anche i Cavalieri del Tempio hanno organizzato delle esibizioni: quelle sono sempre una meraviglia, credimi." }
  ]
}
