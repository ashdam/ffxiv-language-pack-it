    { "gameKey": "custom/004/RegSeaPvpSeasonTicket_00438#TEXT_REGSEAPVPSEASONTICKET_00438_SEASONREWARD2_000_000", "hash": "5AC829D7608E4AF1", "target": "Ah, ecco un lupo assetato di sangue, <if(gnum4,regina,re)> del branco! Se hai con te dei Wolf Collars, li toglierò volentieri dal tuo collo possente in cambio di una ricompensa." },
    { "gameKey": "custom/004/RegSeaPvpSeasonTicket_00438#TEXT_REGSEAPVPSEASONTICKET_00438_MENU_000_000", "hash": "412834AE57DBBACD", "target": "Cosa desideri fare?" },
    { "gameKey": "custom/004/RegSeaPvpSeasonTicket_00438#TEXT_REGSEAPVPSEASONTICKET_00438_MENU_000_001", "hash": "46FFC46BD9A45572", "target": "Scambiare per un’arma (10 collari)" },
    { "gameKey": "custom/004/RegSeaPvpSeasonTicket_00438#TEXT_REGSEAPVPSEASONTICKET_00438_MENU_000_002", "hash": "7F8D3307F71282FC", "target": "Scambiare per Wolf Marks (1 collare)" },
    { "gameKey": "custom/004/RegSeaPvpSeasonTicket_00438#TEXT_REGSEAPVPSEASONTICKET_00438_MENU_000_003", "hash": "463C3F534C7B4A0C", "target": "Chiedere informazioni sui Wolf Collars" },
    { "gameKey": "custom/004/RegSeaPvpSeasonTicket_00438#TEXT_REGSEAPVPSEASONTICKET_00438_MENU_000_004", "hash": "6195213F6CCA6686", "target": "Esci" },
    { "gameKey": "custom/004/RegSeaPvpSeasonTicket_00438#TEXT_REGSEAPVPSEASONTICKET_00438_SEASONREWARD2_001_000", "hash": "C7132987F3DBAD3A", "target": "Hai lasciato a casa i collari, eh? Mi aspettavo che una bestia feroce come te ne avesse da parte almeno una ventina." },
    { "gameKey": "custom/004/RegSeaPvpSeasonTicket_00438#TEXT_REGSEAPVPSEASONTICKET_00438_SEASONREWARD2_001_001", "hash": "4CACEECACBA640DA", "target": "Mh, pare che tu abbia già tutti i Wolf Marks che puoi portare. Sono le regole, purtroppo." },
    { "gameKey": "custom/004/RegSeaPvpSeasonTicket_00438#TEXT_REGSEAPVPSEASONTICKET_00438_ASK_000_000", "hash": "81037549917BEA5F", "target": "Scambiare un Wolf Collar con <kilo(lnum3,\\,)> <ennoun(Item,3,lnum2,2,1)>?" },
    { "gameKey": "custom/004/RegSeaPvpSeasonTicket_00438#TEXT_REGSEAPVPSEASONTICKET_00438_ASK_000_001", "hash": "9D44F373A91651D0", "target": "Attenzione: non potrai ricevere tutti i Wolf Marks. Vuoi procedere comunque?" },
    { "gameKey": "custom/004/RegSeaPvpSeasonTicket_00438#TEXT_REGSEAPVPSEASONTICKET_00438_SEASONREWARD2_002_000", "hash": "F5BAE6108EF02322", "target": "Ecco i tuoi Wolf Marks. Te li sei guadagnati." },
    { "gameKey": "custom/004/RegSeaPvpSeasonTicket_00438#TEXT_REGSEAPVPSEASONTICKET_00438_SYSTEM_002_000", "hash": "8CF25A3711AA6C25", "target": "Transazione annullata." },
    { "gameKey": "custom/004/RegSeaPvpSeasonTicket_00438#TEXT_REGSEAPVPSEASONTICKET_00438_SEASONREWARD2_003_000", "hash": "3335AC7F53E4F8F8", "target": "I Wolf Collars sono la prova del tuo valore. Vengono assegnati alla fine di una stagione di the Feast in base al punteggio." },
    { "gameKey": "custom/004/RegSeaPvpSeasonTicket_00438#TEXT_REGSEAPVPSEASONTICKET_00438_SEASONREWARD2_003_001", "hash": "AFC0E63AE3F16E4F", "target": "La quantità di collari che ricevi dipende dalla fascia in cui ti trovi alla fine della stagione. Più alta è la fascia, più ne guadagni. Quindi sfodera zanne e artigli e fatti strada verso la gloria a morsi e squarci!" },
    { "gameKey": "custom/004/RegSeaPvpSeasonTicket_00438#TEXT_REGSEAPVPSEASONTICKET_00438_SEASONREWARD2_003_002", "hash": "CF9A635D57082C0F", "target": "Ma i Wolf Collars non servono solo a fare scena. Qui puoi scambiarli con Wolf Marks e armi. Non hai abbastanza collari per quello che desideri? Fatti venire più fame e guadagnane altri la prossima stagione." }
  ]
