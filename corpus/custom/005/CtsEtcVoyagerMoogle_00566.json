    { "gameKey": "custom/005/CtsEtcVoyagerMoogle_00566#TEXT_CTSETCVOYAGERMOOGLE_00566_Q1_000_000", "hash": "987653DE43505B5A", "target": "Cosa vuoi fare?" },
