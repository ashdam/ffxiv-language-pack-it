    { "gameKey": "custom/005/CtsEtcVoyagerMoogle_00566#TEXT_CTSETCVOYAGERMOOGLE_00566_MOGGUIDEBOOK_00001", "hash": "4796F1CC20C77395", "target": "Il Mogpendium sarà una risorsa preziosissima durante il Forziere del Moguri, kupò!" },
