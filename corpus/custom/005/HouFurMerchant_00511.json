    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE1", "hash": "7DD3CEDEA0BA0800", "target": "Sono qui, <if(gnum4,Padrona,Padrone)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE2", "hash": "5A62FE8EAF415E5D", "target": "Non hai niente di cui preoccuparti." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE3", "hash": "CE00F65C00EBC5BE", "target": "Mi hai chiamato?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE4", "hash": "859B08A2503A5AAE", "target": "Sì? \\<sospiro> Spero non ci voglia molto..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE5", "hash": "F638B81C23CDA6FF", "target": "Vuoi vedere come un maestro gestisce un bazar?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE6", "hash": "5AE55FA7CC9C0621", "target": "Salve, salve! Mi hai chiamato?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE1", "hash": "F5C949592DDFEC3B", "target": "Al vostro servizio, <if(gnum4,mia signora,mio signore)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE2", "hash": "012F7F46513EB2D9", "target": "Che si fa stavolta, tesoro?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE3", "hash": "7C7B9158EC1A110C", "target": "Cosa mi chiedete?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE4", "hash": "52F62D6DA83D4308", "target": "Mi dispiace tanto di avervi fatto aspettare, <if(gnum4,signora,signore)>. Tanto, tanto." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE5", "hash": "1E8A617D04953C1B", "target": "Sbrigati, ho da fare altrove." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE6", "hash": "B9571B5551F411DE", "target": "Ma guarda <if(gnum4,la mia cliente preferita,il mio cliente preferito)>! È sempre un piacere, <if(gnum4,signora,signore)>!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE1", "hash": "2AB8C1FBE249A401", "target": "Sì, <if(gnum4,signora,signore)>? Quali sono i vostri ordini?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE2", "hash": "D58014FF6C45B694", "target": "Che c'è in programma, capo? Togliere ai gonzi i loro sudati gil?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE3", "hash": "82FD2BB233D9BE05", "target": "Sono arrivato. Puoi procedere." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE4", "hash": "17AB77EC51236518", "target": "Oh, salve. A cosa devo il piacere?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE5", "hash": "BDF39A6397039511", "target": "Sono qui per affari, soltanto per affari." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE6", "hash": "3C7C0EACC41411D0", "target": "Vi vedo in buona salute, <if(gnum4,signora,signore)>. Come posso aiutarvi in questo bel momento <if([gnum11<12],<if([gnum11<4],della serata,del mattino)>,<if([gnum11<17],della giornata,della serata)>)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE1", "hash": "9E1295E7AC4B9C21", "target": "Che cosa desiderate da me, <if(gnum4,mia signora,mio signore)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE2", "hash": "7D3FC139E86984E1", "target": "Di solito sono io a chiamare e sono gli altri ad aspettare." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE3", "hash": "ED24FF5DA930F1A4", "target": "Posso aiutarvi in qualcosa?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE4", "hash": "902F16D65FE73B8C", "target": "Oh, perché devi chiamarmi proprio ora...?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE5", "hash": "C06BBA87E06578C8", "target": "Sono certa che ci sia un'ottima spiegazione per questa chiamata." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE6", "hash": "B1C5B59644878380", "target": "Sapete, pensavo che sareste presto <if(gnum4,venuta,venuto)> a chiamarmi. Vi assicuro che sono pronta e impaziente di servirvi." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE1", "hash": "D1D730C68C6DEC11", "target": "Salute a voi, <if(gnum4,signora,signore)>. Il vostro umile servitore ha udito la chiamata." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE2", "hash": "F84C47511BA25E9A", "target": "Saluti e ossequi, <if(gnum4,mia signora,mio signore)>. Dite cosa desiderate e farò del mio meglio per accontentarvi." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE3", "hash": "796B673E9A13C265", "target": "Mi chiedevo quando ti saresti <if(gnum4,decisa,deciso)> a chiamarmi." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE4", "hash": "8CF9411B6556587D", "target": "Possiamo fare in fretta? Mi aspetta una bella ragazza." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE5", "hash": "00FF44E6FC84A0C2", "target": "Cosa?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE6", "hash": "4BF98D696634555A", "target": "Sono qui, sono qui!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE1", "hash": "C274C397AD53CB55", "target": "Eccomi, <if(gnum4,Padrona,Padrone)>, come avete richiesto." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE2", "hash": "612E4AD32C521C44", "target": "Ciao, tesoro. Che c'è da fare?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE3", "hash": "B8B60A6D01456F11", "target": "Non mi lascio sfuggire occasioni per riempire queste tasche." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE4", "hash": "8D1865E0370A49A5", "target": "Be', questa è una sorpresa! Che si fa?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE5", "hash": "2F5E335CA2862111", "target": "E adesso che c'è?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE6", "hash": "970A04EB398CB378", "target": "Eccooooomi!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE1", "hash": "5E1F967DF05D820C", "target": "Come posso esserrrvi utile, <if(gnum4,signora,signore)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE2", "hash": "B14A234DB7837713", "target": "Là fuori è una guerra, <if(gnum4,signorina,signore)>. Non avete idea." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE3", "hash": "5905787E93C032F7", "target": "..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE4", "hash": "3F43AD9F909D6289", "target": "Affari o piacere?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE5", "hash": "B3674C9612925B93", "target": "Presumo non mi abbiate chiamato soltanto per il piacere della mia compagnia." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE6", "hash": "F547E9C270766A63", "target": "Proprio <if(gnum4,la bella fanciulla,il bel giovane)> che speravo di vedere! Dimmi cosa desidera il tuo cuore." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE1", "hash": "CD2FB037367201E6", "target": "Spero che il richiamo felino non fosse per rimproverarmi." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE2", "hash": "0F20EAB84B905EEE", "target": "Avete suonato, <if(gnum4,mia signora,mio signore)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE3", "hash": "9BF08255180A7428", "target": "Alle orecchie di un gatto sfugge ben poco, men che meno una chiamata." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE4", "hash": "BCFBAF5F1F836346", "target": "La curiosità ha chiamato la gatta. Cosa hai per me oggi?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE5", "hash": "20D400D64318A1E8", "target": "Sono pronta quando vuoi." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE6", "hash": "AB7245A1A5361A50", "target": "Pensavo proprio a te!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE1", "hash": "DC7509EFD4EE906B", "target": "Di cosa avete bisogno oggi, <if(gnum4,signora,signore)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE2", "hash": "0F74038BDDC1274B", "target": "Buahahah! Hai lavoro da fare? Indicami solo la maledetta direzione giusta." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE3", "hash": "EA201EF608AEFADC", "target": "Sono qui. Che c'è?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE4", "hash": "2CA66C9D8A3A5E8B", "target": "Ehilà... hic... <if(gnum4,bellezza,compare)>! Ti va una pinta con me?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE5", "hash": "86D3758D6307C489", "target": "Non potevo arrivare prima. Dov'è il lavoro?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE6", "hash": "6B02C3F1AF4A2B25", "target": "Sono corso appena ho sentito la campana! Ti serve qualcosa, capo?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE1", "hash": "4CC428F6640E9C71", "target": "Sono a vostra disposizione, <if(gnum4,mia signora,mio signore)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE2", "hash": "3A635206D530D151", "target": "Hai qualcosa per me, capitano?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE3", "hash": "514CB62E02D15C66", "target": "Dite pure, <if(gnum4,signora,signore)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE4", "hash": "750F501436084153", "target": "Facciamo in fretta e senza storie, va bene?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE5", "hash": "9EEC19972F7A1AB8", "target": "Non sarebbe necessario se affidaste a me i vostri affari finanziari." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE6", "hash": "0923F1B49CF66C2E", "target": "Allora: vendere, comprare, bere o andare a puttane? Che si fa oggi?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE1", "hash": "69E2C419843E145B", "target": "Salute, <if(gnum4,signora,signore)>. Come posso servirvi?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE2", "hash": "AFC46CAC3F1B77CF", "target": "Che si fa, <if(gnum4,signorina,compare)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE3", "hash": "BEF93F1846E7D792", "target": "Dimmi cosa vuoi." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE4", "hash": "6F6244639104247D", "target": "Come ti trovi in questo splendido momento <if([gnum11<12],<if([gnum11<4],della serata,della giornata)>,<if([gnum11<17],della giornata,della serata)>)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE5", "hash": "CE3347D641BAB9FD", "target": "Be'... Eccomi qui... <if(gnum4,Padrona,Padrone)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE6", "hash": "8BC9D106BD0609B5", "target": "Lavoriamo fra i mercati,♪<br>con le belle uniformi addosso;♪<br>uomini sobri e fidati,♪<br>al dovere diamo il massimo!♪" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE1", "hash": "1A4D886EA936445D", "target": "<if(gnum4,Mia signora,Mio signore)>. Cosa desiderate da me?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE2", "hash": "415B5CF8E4F87007", "target": "Allora, lo facciamo?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE3", "hash": "EC8C44309097A931", "target": "Sì?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE4", "hash": "60E22049088269DE", "target": "Ehi, sei... sei tu! Ciao ancora, tu!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE5", "hash": "8498C894B22C4603", "target": "N-non è che voglia vendere i tuoi oggetti o altro." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE6", "hash": "44E20E73EDEB780E", "target": "Cosa hai per me? Avanti, avanti! Non fare complimenti!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE1", "hash": "8A083E1A6FD76849", "target": "Avete suonato, <if(gnum4,mia signora,mio signore)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE2", "hash": "2E65686EF7AC1A78", "target": "Confido che ne varrà la pena." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE3", "hash": "59E897BE3EA9B59A", "target": "<italic(1)>Cosa<italic(0)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE4", "hash": "2487E7ACF5239240", "target": "Qualunque cosa ti serva, lascia fare a me! Ho i miei metodi." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE5", "hash": "938D05EC6A512509", "target": "Gahahah! Ma guarda <if(gnum4,la mia padrona preferita,il mio padrone preferito)>!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE6", "hash": "7C84CB32D00AEABD", "target": "Sono io, il tuo retainer più leale e capace!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE1", "hash": "7425F30367D9CFDF", "target": "Che si fa, tesoro?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE2", "hash": "3695A28EF246A58C", "target": "I tuoi ordini! Voglio sentirli subito!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE3", "hash": "190B34BAEFE15AC7", "target": "Se vuoi chiedermi qualcosa, chiedi." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE4", "hash": "20CC450A51D26342", "target": "Sì...? Ti serve... \\<sbadiglio>... qualcosa?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE5", "hash": "FA8EE46ECAD554D5", "target": "Un compito per me? Spero sia divertente!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE6", "hash": "D4537748FEA28406", "target": "Sono qui per eseguire ogni vostro ordine, <if(gnum4,Padrona,Padrone)>! Chiedetemi qualunque cosa!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE1", "hash": "3B4F2478F64B414D", "target": "Attendevo la vostra chiamata, <if(gnum4,signora,signore)>. Cosa desiderate da me in questo bel momento <if([gnum11<12],<if([gnum11<4],della serata,del mattino)>,<if([gnum11<17],della giornata,della serata)>)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE2", "hash": "5F56E6E9F8174AE6", "target": "Cosa posso fare per voi, <if(gnum4,mia signora,mio signore)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE3", "hash": "AE1FBFC5AE9B7F14", "target": "Mi avete chiamato, <if(gnum4,signora,signore)>...?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE4", "hash": "C6300B9819E9144C", "target": "Hai... hic... suonato?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE5", "hash": "88BD26F9FFF475AF", "target": "Ti serve aiuto? Allora facciamo in fretta." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE6", "hash": "81A814A7B1D7A52D", "target": "Avete il mio orecchio, <if(gnum4,mia signora,mio signore)>. Anzi, tutti e due!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE1", "hash": "BEABDBFBE0D456A5", "target": "Mi avete chiamata, <if(gnum4,signora,signore)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE2", "hash": "497DF99CF329948B", "target": "Al tuo servizio a ogni cenno!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE3", "hash": "F5AB8C10D40B23CA", "target": "Mi hai chiamata ed eccomi qui." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE4", "hash": "EDAB70F474EDE4DC", "target": "Finalmente! Credevo non mi avreste chiamata <italic(1)>mai<italic(0)>. Di cosa ha bisogno <if(gnum4,la mia signora,il mio signore)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE5", "hash": "B8811F3FDA5013F0", "target": "Possibile...? La celebrità <split(<string(gstr1)>, ,1)> ha chiamato <italic(1)>me<italic(0)>? \\<risatina>" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE6", "hash": "0FEF2A4C857E019F", "target": "Sì, sì, eccomi! Pronta in un attimo!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE1", "hash": "88D463EC8F658FA7", "target": "Se è tutto, prendo congedo, <if(gnum4,Padrona,Padrone)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE2", "hash": "849D81FC7DAD90B3", "target": "Abbi cura di te, capito?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE3", "hash": "E1099B5E7A356733", "target": "Al prossimo incontro." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE4", "hash": "3FB6CD3E06EC78BE", "target": "Be', era ora. Arrivederci." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE5", "hash": "F24FB14000CF01A7", "target": "Credo di meritare un ringraziamento." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE6", "hash": "4A02FE143E4553C2", "target": "Allora vado!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE1", "hash": "A1D16E93FE280EE5", "target": "Con il vostro permesso, <if(gnum4,mia signora,mio signore)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE2", "hash": "EA2E1ABB7A29A1F0", "target": "Non preoccuparti di nulla. Ci penso io." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE3", "hash": "893A335E51F1497D", "target": "Allora, arrivederci." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE4", "hash": "0C503B4EBE46A5BC", "target": "Se non c'è altro, <if(gnum4,signora,signore)>, ora vado." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE5", "hash": "0372772E633E82A8", "target": "È tutto? Molto bene, alla prossima." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE6", "hash": "C4E9F6F39D7CAC42", "target": "Oh, è tutto per oggi? Molto bene, ma promettetemi che tornerete presto!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE1", "hash": "6ECC28A5A20CFF53", "target": "Come sempre, <if(gnum4,signora,signore)>, è stato un onore e un privilegio." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE2", "hash": "334707F26ED0F881", "target": "Puoi contare su di me, capo. So come sbrigare le cose." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE3", "hash": "3A5B427C8D71EADF", "target": "Non sparire." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE4", "hash": "AB2D78180890554D", "target": "Giuro che sarà fatto. Prima o poi." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE5", "hash": "6E233E5428D80033", "target": "Come desideri." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE6", "hash": "6FFEB5415F61E4EF", "target": "Splendido! Eseguirò subito i vostri ordini." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE1", "hash": "60FFCA2960EDF641", "target": "Attendo umilmente la prossima chiamata, <if(gnum4,mia signora,mio signore)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE2", "hash": "EE70BF1D65137631", "target": "Non lasciarmi sola troppo a lungo, capito?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE3", "hash": "AFF49D7A5FFE694F", "target": "Sempre un piacere." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE4", "hash": "E9A09D8DFF23EC4A", "target": "È tutto, sì? Allora, se vuoi scusarmi..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE5", "hash": "F255DE42810E1852", "target": "Credo che per ora i nostri affari siano conclusi." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE6", "hash": "6D8EE315750B9273", "target": "Non desiderate davvero altro? Proprio nulla? Molto bene, prendo congedo." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE1", "hash": "01A81DD41FBC9E36", "target": "Ogni vostro desiderio sarà esaudito rapidamente, con la dovuta cura e attenzione." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE2", "hash": "5BF7B95AC3847613", "target": "Non dovrebbe volerci più di un momento, <if(gnum4,mia signora,mio signore)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE3", "hash": "E09DE56E4D72C33C", "target": "Allora vado." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE4", "hash": "B208AF9A6ADB7064", "target": "Grazie agli dèi abbiamo finito. Ho intenzione di mettere le mani in posti mai visti... se capisci cosa intendo." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE5", "hash": "6A30C711FF4F87AC", "target": "Stammi bene." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE6", "hash": "0092D04A83F9E6C9", "target": "Vado, vado!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE1", "hash": "DF69E40794DFE5FF", "target": "Al prossimo incontro!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE2", "hash": "99CFC19E40715296", "target": "Che i Dodici ti benedicano." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE3", "hash": "9CD78DADB67CBFFF", "target": "Che Nald'thal ci riempia le tasche!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE4", "hash": "9EAB87FFF6DE0A5C", "target": "Molto bene, <if(gnum4,signora,signore)>! Ogni vostro desiderio è un ordine, e così via." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE5", "hash": "7018FB750ECE9AC9", "target": "Sai come trovarmi." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE6", "hash": "6C57F9571D77D01A", "target": "È già tempo di saluti? Mi mancherai..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE1", "hash": "69A1455EE27222E0", "target": "Sia fatta la vostra volontà." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE2", "hash": "667F50DAFC05A4DB", "target": "I mercati saranno anche un maledetto campo di battaglia, ma io sono un dannato soldato. Potete contare su di me, <if(gnum4,signora,signore)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE3", "hash": "38CCA131983915D1", "target": "..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE4", "hash": "804330C723245237", "target": "Perché tanto serrr<if(gnum4,ia,io)>? \\<sospiro> Così va il mondo." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE5", "hash": "B59127539CDD2BFD", "target": "Non credo proprio che servisse la mia presenza di persona, ma quel che è fatto è fatto." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE6", "hash": "D32B63CEF4C6D9BB", "target": "Dunque ho soddisfatto ogni tuo bisogno? Eccellente! Mi fa tanto piacere servire la clientela." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE1", "hash": "22414922F1935BF1", "target": "Per ora, arrivederci, <if(gnum4,signora,signorrre)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE2", "hash": "108B6F2259B60130", "target": "Bene, allora mettiamoci al lavoro!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE3", "hash": "52DE8CE9A6D8E20F", "target": "Non c'è motivo di prrreoccuparsi." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE4", "hash": "290EF929E78637B8", "target": "Quando il padrone non c'è, la gatta balla." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE5", "hash": "FA8C7C6065ED53D2", "target": "Dèi, che stanchezza..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE6", "hash": "DE8DA50F9F8D2F27", "target": "Non vuoi più stare con me? \\<singhiozzo>" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE1", "hash": "418E2CED424D412C", "target": "Eseguirò i vostri desideri come ordinato, <if(gnum4,signora,signore)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE2", "hash": "A7F32FBEAEAE1CD7", "target": "Buahahah! Sono nel tuo bazar a vendere la tua roba!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE3", "hash": "596A086169C8620D", "target": "Ora vado." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE4", "hash": "1FE03AB6FA4EF373", "target": "Ahhh, accidenti. Mi sa che devo mettermi al lavoro..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE5", "hash": "5CA5DCD20541D622", "target": "Non sono tipo da saluti." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE6", "hash": "18485E817E9798B3", "target": "Va' a dormire un po', capo. Hai una faccia terribile!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE1", "hash": "D50869DEEA72EAFE", "target": "È tutto per oggi, <if(gnum4,mia signora,mio signore)>? Ricevuto." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE2", "hash": "2726DC3430FFBA96", "target": "Agli ordini, capitano!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE3", "hash": "6EBDC0D3C0F81F8E", "target": "Ricevuto." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE4", "hash": "54DBADDD740606F3", "target": "Non era proprio come speravo di passare la giornata, ma immagino non ci sia rimedio." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE5", "hash": "7240C430DA6E781B", "target": "Non spetta a noi chiedere perché. A noi tocca solo agire e morire." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE6", "hash": "6684A74D00421F25", "target": "Sempre professionale fino in fondo, vedo. Allora, alla prossima." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE1", "hash": "C90E7BD661A1A30E", "target": "Se non c'è altro, prendo congedo." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE2", "hash": "4339ABC23A6F44A2", "target": "È tutto? Mi sa che allora vado." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE3", "hash": "1D1B916C6F3A51FB", "target": "Ultime richieste? Molto bene. Eh eh eh... Ehm." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE4", "hash": "743EEE2C92662B7E", "target": "Ah, sì, certo. Il dovere chiama!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE5", "hash": "BBAE10CEC574F875", "target": "Dunque non hai più bisogno di me?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE6", "hash": "8D85563251905149", "target": "Oggi ci sono, domani chissà;♪<br>sì, lo so,♪<br>così si va!♪" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE1", "hash": "242AEA23EBED69FE", "target": "Se mai vi servissi, basta suonare." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE2", "hash": "B561EBF9455B518A", "target": "Sempre un piacere, <if(gnum4,Padrona,Padrone)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE3", "hash": "20204685B662AD42", "target": "Bene, allora." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE4", "hash": "74CDBCCD81DB5BCD", "target": "Già finito? Mi sa che è tutto, allora." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE5", "hash": "B2F10572DA703959", "target": "Vai già via? Bene, allora! N-non è che volessi farti restare o altro." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE6", "hash": "190A5792CC613B94", "target": "Molto bene, <if(gnum4,signora,signore)>! Davvero molto bene!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE1", "hash": "0CDF98D15F0140D2", "target": "È sempre un piacere servirvi, <if(gnum4,mia signora,mio signore)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE2", "hash": "6CF858424E547F48", "target": "Umpf. Spero che la prossima volta avrai un compito più sensato per me." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE3", "hash": "1B098026D0C1AF7C", "target": "<italic(1)>Arrivederci<italic(0)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE4", "hash": "8CA330509327D281", "target": "E con questo vado. Luoghi da visitare, gente da vedere." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE5", "hash": "BFA406B47E85CE14", "target": "Bahahah! Alla prossima, <if(gnum4,amica mia,amico mio)>!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE6", "hash": "7CFECEDB1D62B750", "target": "Chiamami quando vuoi! Sai che non ti deluderò mai!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE1", "hash": "AEEE2C0A3BEA4681", "target": "Per qualunque necessità, basta suonare." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE2", "hash": "7D84B777BCB5A896", "target": "E io vado!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE3", "hash": "4580EE2773C12030", "target": "Chiamami quando vuoi. Se ne avrò voglia, risponderò." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE4", "hash": "52EC9A9CA2925BA2", "target": "È tutto, suppongo...? \\<sbadiglio> Molto bene..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE5", "hash": "CF979F188FA5FD94", "target": "È tutto? Oh, speravo ci fosse altro..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE6", "hash": "9DFB282B9E8A396B", "target": "È tutto ciò che vi serve da me? Ma potrei ancora servirvi in tanti modi!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE1", "hash": "8D41CD2616D593CA", "target": "Non esitate a chiamarmi di nuovo. Buona fortuna nelle vostre imprese, <if(gnum4,signora,signore)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE2", "hash": "8EE855ACB28966EB", "target": "Basta una parola, <if(gnum4,mia signora,mio signore)>, e sarò subito qui, tutto per voi." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE3", "hash": "323C3622A19961A8", "target": "Se non avete più bisogno dei miei servigi..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE4", "hash": "4296B8FB1223B597", "target": "Allora vado a bere un altro bicchiere. Sai dove trovarmi!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE5", "hash": "59D5A545495AEFA2", "target": "Cosa... tutto qui? Hai <italic(1)>davvero<italic(0)> bisogno di un retainer?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE6", "hash": "E2EC97966E1A318B", "target": "Nient'altro? Allora me la filo saltellando." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE1", "hash": "F8740AD6E1165066", "target": "Sono felice di essere stata utile. Non strafate, <if(gnum4,signora,signore)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE2", "hash": "421BFCBABFED884B", "target": "Ne hai abbastanza di me, eh? Va bene! Fammi sapere se ti serve altro!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE3", "hash": "39312F369BCC7E1C", "target": "Abbiamo finito? Allora prendo congedo." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE4", "hash": "1089923CA3E0BAAA", "target": "Non occorre altro <if(gnum4,alla mia signora,al mio signore)>? Allora affilerò gli artigli in attesa della prossima chiamata." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE5", "hash": "DE833458A602DCB5", "target": "Nient'altro? Bene... Allora vado!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE6", "hash": "2A697BAEF75219E1", "target": "Hai tutto ciò che ti serve? Allora faccio un pisolino." }
  ]
}
