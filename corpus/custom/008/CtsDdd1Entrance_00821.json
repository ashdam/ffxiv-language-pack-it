    { "gameKey": "custom/008/CtsDdd1Entrance_00821#TEXT_CTSDDD1ENTRANCE_00821_TEST_ENTER_MATCHING_Q", "hash": "9BE81FDAFFF86489", "target": "Vuoi davvero entrare con un gruppo abbinato?" },
    { "gameKey": "custom/008/CtsDdd1Entrance_00821#TEXT_CTSDDD1ENTRANCE_00821_WOODWAILERCAPTAIN01556_000_050", "hash": "7C772C2E971CDB89", "target": "Vorresti entrare nelle rovine senza compagnia!? La magia di quel luogo ti indebolirà, e avrai soltanto le armi eteree dei Padjal ad aiutarti. Persino quelle potrebbero non bastare senza potenziamenti." },
    { "gameKey": "custom/008/CtsDdd1Entrance_00821#TEXT_CTSDDD1ENTRANCE_00821_TEST_ENTER_SOLO", "hash": "1A51FF6350853447", "target": "Vuoi davvero entrare senza compagnia?" },
