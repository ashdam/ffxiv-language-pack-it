  "entries": [
    { "gameKey": "custom/008/CtsDdd1Entrance_00821#TEXT_CTSDDD1ENTRANCE_00821_WOODWAILERCAPTAIN01556_000_000", "hash": "951BAF65DE8465C0", "target": "Una grave minaccia alla pace del Sudario si è manifestata, e mi hanno inviato ad aiutare a scacciarla. Avventurieri o meno, non permetterò a nessuno di intralciare il mio lavoro. Ora, per favore, prosegui." },
    { "gameKey": "custom/008/CtsDdd1Entrance_00821#TEXT_CTSDDD1ENTRANCE_00821_WOODWAILERCAPTAIN01556_000_020", "hash": "E440444D28FE400F", "target": "Per fortuna il curatore di quel luogo maledetto è stato tanto sbadato da lasciare i suoi appunti dove potevamo trovarli. Forse ora scopriremo le sue vere intenzioni." },
