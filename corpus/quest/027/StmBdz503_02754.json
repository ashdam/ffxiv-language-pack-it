{
  "conversation": "quest/027/StmBdz503_02754",
  "gameVersion": "2026.11.03.0000.0000",
  "entries": [
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_SEQ_00", "hash": "0B0D5E146BB9C51B", "target": "Tamachag vuole vederci chiaro su certi affari poco puliti." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TODO_00", "hash": "A93BCF86A09B70B2", "target": "Visita le bancarelle indicate sulla mappa" },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TODO_01", "hash": "36BDE2AC6B980307", "target": "Fai rapporto a Tamachag" },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_001", "hash": "D5A8B80C9307E64F", "target": "Mi daresti una mano con un'indagine?" },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_002", "hash": "2340DF276D886EDC", "target": "Qui ogni mercante decide a quanto vendere. Ho saputo però che qualcuno ne approfitta per alzare i prezzi solo con i clienti forestieri." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_004", "hash": "DA2B13FCA7AA3F5D", "target": "Se continua così, Piazzamercato si farà una pessima fama. Controllo regolarmente le bancarelle, ma sospetto che chi lo fa mi tenga all'oscuro dei rincari." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_005", "hash": "0A8CD9BF1190554C", "target": "Per questo mi serve una mano. Fa' un giro fra i mercanti e prendi nota di quel che vendono e di quanto chiedono." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_006", "hash": "EE496D01F046BF4C", "target": "Ti ho segnato sulla mappa le cinque bancarelle da visitare. Quando hai finito, vieni a riferirmi quel che hai visto." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_010", "hash": "C587CCECC401BBB0", "target": "Ti ho segnato sulla mappa le cinque bancarelle da visitare. Quando hai finito, vieni a riferirmi quel che hai visto." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_BAIDUR_000_020", "hash": "D7FEF37B860A73D7", "target": "Cerchi qualcosa che non trovi da nessuna parte? Da me l'avrai di sicuro!" },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_SYSTEM_000_021", "hash": "E1390AB00FDF884A", "target": "Baidur vende carne, pesce e qualche ninnolo. La sua merce costa poco." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_MASGUD_000_030", "hash": "375C0C23D1873C93", "target": "Venite a comprare la frutta e la verdura più succose di Piazzamercato!" },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_SYSTEM_000_031", "hash": "48C02B0467CAD254", "target": "Masgud vende frutta e verdura. La sua merce costa molto." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_YESUI_000_040", "hash": "0DD4601AB1AF6A41", "target": "Ehi, ti va un po' di carne affumicata? Costosa, sì, ma vedrai che non te ne pentirai." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_SYSTEM_000_041", "hash": "3E312AD405A0E957", "target": "Yesui vende carne cruda, salsicce e prodotti affumicati. La sua merce costa molto." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_BOTOKHUI_000_050", "hash": "3851FD061DAFB20A", "target": "Ma guarda che aria esotica... Devi venire da lontano! Ti interessa un po' di kumis? È la più raffinata delle bevande locali che ho da offrire." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_SYSTEM_000_051", "hash": "F39C19D13CEEC333", "target": "Botokhui vende bevande alcoliche di vario tipo. La sua merce costa moltissimo." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_CHAMBUI_000_060", "hash": "4D9AE791E49E23B5", "target": "Quanti buuz desideri, <if(gnum4,signorina,signore)>?" },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_SYSTEM_000_061", "hash": "3FEA1B5B0B33DE86", "target": "Chambui vende diversi tipi di buuz. La sua merce costa il giusto." },
