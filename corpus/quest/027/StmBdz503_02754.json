    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_140", "hash": "0FBD848B036EF91E", "target": "Più o meno è quello che avevo scoperto anch'io. Tranne che per Botokhui." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_141", "hash": "382D15BF639A9961", "target": "Il kumis da queste parti non è certo un lusso. Contava sul fatto che chi viene da fuori, come te, non se ne intendesse." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_142", "hash": "2C3EE1C0B457D38D", "target": "Non può continuare così. Più tardi le farò un bel discorsetto." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_143", "hash": "4052D877DCB8C0D2", "target": "Grazie della mano. I Qestir mi avevano affidato una ricompensa per chi fosse riuscito ad aiutarmi a smascherare chi imbrogliava i clienti. Direi che te la sei meritata." },
    { "gameKey": "quest/027/StmBdz503_02754#TEXT_STMBDZ503_02754_TAMACHAG_000_150", "hash": "CF5821A029C703A8", "target": "Ne sei davvero <if(gnum4,sicura,sicuro)>? Mi sembravi un po' in dubbio. Se non ricordi bene, torna pure a dare un'occhiata alle bancarelle." }
  ]
