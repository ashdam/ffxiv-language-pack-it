{
  "conversation": "quest/036/LucKmd115_03620",
  "gameVersion": "2026.09.15.0000.0000",
  "entries": [
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_SEQ_00", "hash": "39666F40D926930C", "target": "Lo sguardo di Minfilia esprime in egual misura apprensione e determinazione." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_00", "hash": "B5308555418FFFF8", "target": "Esaminare il luogo designato" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_01", "hash": "A5C84C567FE62429", "target": "Cercare Minfilia" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_02", "hash": "838274F23593FE96", "target": "Cercare Thancred" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_000", "hash": "98FAB62BF47CF33F", "target": "Riesco a percepire la sua presenza, seppure debolmente." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_001", "hash": "14BB5ED3DC446C07", "target": "Vieni, guardiamo vicino alla parete di cristallo." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_010", "hash": "B043A9C82585C2F3", "target": "Era qui. In cima a questo edificio..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_020", "hash": "01F8AFBF7774509E", "target": "\\<gemito>" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_021", "hash": "1F98560B1F8E0DE8", "target": "Cos'è successo? Ricordo che parlavo con Minfilia... e poi..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_022", "hash": "C4CB2D099EA55F50", "target": "Qualcosa non va?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_Q1_000_000", "hash": "A29250F2F5F49059", "target": "Che cosa dirai?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A1_000_001", "hash": "C1ED64E72EA447DA", "target": "I tuoi capelli sono cambiati." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A1_000_002", "hash": "8D0C20CBF9CB5461", "target": "I tuoi occhi sono cambiati." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_023", "hash": "1EF3A43F9F893B03", "target": "Credo sia un dono d'addio." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_024", "hash": "85C24CD3785579BD", "target": "Finora ho percorso il sentiero che lei aveva tracciato davanti a me. Quello che aveva tracciato per tutte le Minfilia." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_025", "hash": "E316E0C81CC89833", "target": "Ma mi ha donato un nuovo sentiero─una nuova vita─che posso chiamare mia." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_026", "hash": "B8900FEA1214D900", "target": "E anche se se n'è andata, riesco ancora a sentirla... calda, calma e gentile." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_027", "hash": "290EA0F2689BE40F", "target": "Sento il cuore pulsante del mondo, la Luce che cresce al suo interno." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_028", "hash": "119683F8E011AC88", "target": "E i Guardiani della Luce. Ce n'è uno qui ad Amh Araeng." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_029", "hash": "B664EE7BF1B57A83", "target": "Torniamo in fretta. Gli altri devono saperlo." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_030", "hash": "E0DFBC485C27CBC5", "target": "Non credi che Thancred si arrabbierà con me, vero?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_Q2_000_000", "hash": "00AF7D3842898CBA", "target": "Che cosa dirai?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A2_000_001", "hash": "31211EC39D6F8800", "target": "È ciò che voleva Minfilia. Sono <if(gnum4,certa,certo)> che capirà." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A2_000_002", "hash": "B8D1C6957F02170B", "target": "C'è un solo modo per scoprirlo." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_031", "hash": "142401DF331E0FC1", "target": "Vorrei pensarlo anch'io, ma... \\<sospiro>" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_032", "hash": "88D4673C52E9C2B9", "target": "\\<sospiro> So che non posso evitarlo, ma..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_033", "hash": "94BD0BE3B3AB640A", "target": "Ti dispiacerebbe andare avanti? Sarò subito dietro di te. Lo prometto. " },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_035", "hash": "6B05FE4D20CC5770", "target": "Ho solo... bisogno di un momento per pensare." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_ALPHINAUD_000_040", "hash": "E7F7061234CE8853", "target": "Sei <if(gnum4,tornata,tornato)>! Cominciavamo a preoccuparci per te." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_ALISAIE_000_045", "hash": "24D669121428A4AE", "target": "<split(<string(gstr1)>, ,1)>! Grazie agli dei, stai bene." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_URIANGER_000_050", "hash": "9E218EED8FA0C288", "target": "Sei <if(gnum4,tornata,tornato)>. Ma dov'è Minfilia?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_YSHTOLA_000_055", "hash": "7170DDC2E2315F22", "target": "<if(gnum4,Bentornata,Bentornato)>. Vedo che ti è andata meglio che a Thancred." }
  ]
}
