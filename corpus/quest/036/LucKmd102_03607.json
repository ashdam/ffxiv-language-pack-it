{
  "conversation": "quest/036/LucKmd102_03607",
  "gameVersion": "2026.09.15.0000.0000",
  "entries": [
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_SEQ_00", "hash": "DDDCD3D40B33B28A", "target": "Alisaie riflette su tutto ciò che resta da fare dopo la battaglia." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_TODO_00", "hash": "FF17744E08146D63", "target": "Soccorrere i feriti" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_TODO_01", "hash": "B9D37C7317C9792B", "target": "Parlare con Lyna" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALPHINAUD_000_000", "hash": "60F182438EB6A1C7", "target": "Resisti ancora un momento..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_URIANGER_000_005", "hash": "367B1AEA09249DE9", "target": "Devi restare immobile." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_YSHTOLA_000_010", "hash": "CB523C49CE442E18", "target": "Fai un respiro profondo. Così..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALISAIE_000_020", "hash": "1337C1198EEC75A2", "target": "Gli altri stanno aiutando a curare i feriti. Io li aiuterò a spostarli, ma anche così non abbiamo abbastanza persone." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALISAIE_000_021", "hash": "F26B8C5788EF2D42", "target": "Dopo quello che abbiamo passato, sarai di certo sul punto di crollare─gli dei sanno che lo sono anch'io─ma se potessi occuparti di alcuni pazienti sarebbe di enorme aiuto." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALISAIE_000_022", "hash": "4983B767A78D6DFD", "target": "La capitana Lyna è qui da qualche parte, quindi potresti anche chiederle se ci siano altre necessità urgenti. Parleremo più tardi." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALISAIE_000_025", "hash": "1C468D0DE6630F19", "target": "Resisti. Ti riporteranno al Crystarium sul prossimo carro, te lo prometto..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDA03607_000_030", "hash": "EB6F2FCF9022210E", "target": "Io... Io... \\<ansimo>" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_SYSTEM_000_031", "hash": "09142A9F9078E5B2", "target": "Con gli occhi pieni di lacrime, l'uomo disteso ti guarda. Le dita fremono, come se volesse tenderti la mano, ma non ha la forza di sollevarla." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDA03607_000_032", "hash": "026A21514A7A64BA", "target": "..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDB03607_000_033", "hash": "A430C1BBAC1DE870", "target": "G-Grazie, ma... è troppo tardi." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDB03607_000_034", "hash": "764BD42B13DA9DF9", "target": "Uno di loro... mi ha preso. \\<tosse>" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDB03607_000_035", "hash": "079E3225D8C46368", "target": "Se mi trasformo, vi prego... Vi prego, uccidetemi." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDB03607_000_036", "hash": "DC5F40A8FD07D383", "target": "Mi dispiace... Mi dispiace tanto." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDC03607_000_037", "hash": "2E5A4AB19938951D", "target": "Non toccatemi! Io... Io..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDC03607_000_038", "hash": "1627F30323FC3176", "target": "L'ho uccisa... L'ho uccisa! Era una di loro, lo so, ma io... \\<singhiozzo>" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDC03607_000_039", "hash": "34C4519D9106702C", "target": "Forse me lo merito... Ma <italic(1)>lei<italic(0)>..." }
  ]
}
