{
  "conversation": "quest/040/LucKmj104_04010",
  "gameVersion": "2026.09.15.0000.0000",
  "entries": [
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_SEQ_00", "hash": "883ED9423E6AE222", "target": "Alisaie ha in mente una sola cosa." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_TODO_00", "hash": "F13B2B8B0BEAF143", "target": "Parlare con Alisaie al Comando del Maelstrom" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_TODO_01", "hash": "866335DC27985793", "target": "Parlare con Alphinaud" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_GRAHATIA_100_000", "hash": "6227A20A77DD5F3C", "target": "Purtroppo la squadra delle Officine Garlond non poteva trattenersi─troppo lavoro. Ma per quanto breve sia stato il tempo insieme, è stato <italic(1)>dannatamente<italic(0)> bello vederli!" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALISAIE_000_000", "hash": "374BC9E0946FC7C8", "target": "Finalmente abbiamo la cura..." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_GRAHATIA_100_001", "hash": "EBDEFCDE92D5EDB8", "target": "In teoria. Non saremo certi finché non la proveremo, ma sono cautamente fiducioso." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALISAIE_100_002", "hash": "BFA353A6629C5FAB", "target": "Se dobbiamo provarla su qualcuno, propongo Ga Bu. I suoi sintomi sono relativamente lievi." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_Q1_000_000", "hash": "4C8A026138C40536", "target": "Che cosa dirai?" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_A1_000_001", "hash": "CDAA413180DBB072", "target": "Andrà bene, ne sono <if(gnum4,certa,certo)>." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_A1_000_002", "hash": "5F0DA27D82B0FCB4", "target": "Purché siate prudenti..." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALISAIE_100_003", "hash": "B5A188F4E885C6BA", "target": "Sì. Purché siamo prudenti, andrà bene." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALISAIE_100_004", "hash": "0D8580A00BEF8142", "target": "Senza indugiare, andiamo a Limsa. Ga Bu ha aspettato abbastanza!" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_KRILE_000_010", "hash": "12E6F5BACF8631BA", "target": "Dubito di poter contribuire ancora, quindi farò il tifo da lontano. Buona fortuna con il trattamento." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_TATARU_000_011", "hash": "4B46320B38E3E380", "target": "Pregheremo tutti per il vostro successo!" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_GRAHATIA_000_012", "hash": "376E752FBDAA6B93", "target": "È chiaro che Alisaie è molto affezionata a Ga Bu. Per quanto dipenda da me, farò tutto per riportarlo indietro." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALISAIE_000_013", "hash": "44AEEFB5EDC24FB9", "target": "È il momento della verità. Chiederò a chi ci ospita di portarci subito Ga Bu." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_YSHTOLA_000_014", "hash": "21A50529D31F8AC1", "target": "Alisaie avrà successo, ne sono certa. Dobbiamo solo avere fede." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALPHINAUD_000_015", "hash": "80B2CA6C2C628785", "target": "Questo posto va bene per riposare." }
  ]
}
