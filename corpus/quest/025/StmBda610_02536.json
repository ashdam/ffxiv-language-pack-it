{
  "conversation": "quest/025/StmBda610_02536",
  "gameVersion": "2026.09.15.0000.0000",
  "entries": [
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_SEQ_00", "hash": "0FE358E431BDA3DB", "target": "Alisaie è pronta a lasciare Ala Ghiri quando avrai finito i preparativi." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_TODO_00", "hash": "21AC4C03C90C8ACA", "target": "Pattugliare Wightrock in cerca di forze imperiali" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_TODO_01", "hash": "2F23A23CD9F37831", "target": "Raggiungere Alisaie" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_001", "hash": "CF7EA01691BA6612", "target": "Dobbiamo coprire parecchio terreno, quindi dividiamoci. Se incontri soldati imperiali, sai cosa fare." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_002", "hash": "8C968B641F5B3D71", "target": "E per tua informazione─ho avvertito lo squadrone di Arenvald. Stanno già perlustrando le zone vicine, quindi avremo alleati se incontreremo qualcosa fuori dalla nostra portata." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_BALLOON_000_010", "hash": "6B43B53B4733E8B1", "target": "Forze nemiche avvistate!" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_BALLOON_000_015", "hash": "98555A158F391AC8", "target": "All'attacco! All'attacco!" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_020", "hash": "6B0E4DC19C0A5BE3", "target": "Ah, dammi un momento, <split(<string(gstr1)>, ,1)>." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_200_020", "hash": "DA3B107160666710", "target": "Ripeti, per favore.<br>...Mh. No, per ora mantenete le distanze." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_100_020", "hash": "94F7C227E9939270", "target": "...Ricevuto. Tienimi informata sugli sviluppi." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_021", "hash": "4EB345257AEA5824", "target": "Era Arenvald. La coppia che ci spiava nelle Fringes ci ha seguiti fin qui..." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_022", "hash": "EA2EBCF4E93D3714", "target": "E tu, <split(<string(gstr1)>, ,1)>? Problemi?" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_023", "hash": "8F64A4763FFFFCA4", "target": "...E io che credevo meritassimo un po' di pace. Sono lieta che tu abbia risolto la cosa." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_024", "hash": "956DE7AF29B35555", "target": "Spero che l'assalto a Specula Imperatoris stia andando bene..." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_025", "hash": "7C539CE7E491E78B", "target": "Per i Dodici, hai visto!? La torre principale è appena crollata!" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_026", "hash": "910CC5B0C09E5B1E", "target": "L'hai sentito anche tu, vero? Dev'essere stato il cannone di Castrum Abania. Ma quella era un'installazione imperiale e le loro truppe erano ancora─" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_027", "hash": "FD44AC87437BDC08", "target": "Maledizione, non risponde nessuno! Non so se il linkpearl è disturbato o..." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_028", "hash": "F34095D19F3BBB23", "target": "Dobbiamo andare subito! Hanno bisogno di noi!" }
  ]
}
