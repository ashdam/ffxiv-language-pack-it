{
  "conversation": "quest/049/KinGme105_04936",
  "gameVersion": "2026.09.15.0000.0000",
  "entries": [
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_SEQ_00", "hash": "4DC3BA8430957E22", "target": "Dopo aver esplorato il quartiere a sufficienza, Wuk Lamat è pronta a raggiungere il punto d'incontro." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TODO_00", "hash": "72979CDA504F7460", "target": "Parlare con Wuk Lamat" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TODO_01", "hash": "B00AB75591B48E6E", "target": "Esaminare il luogo indicato" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TODO_02", "hash": "AD8C72E52E2846C2", "target": "Parlare con il bambino Hoobigo dalle scaglie blu e seguirlo in compagnia di Wuk Lamat" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TODO_03", "hash": "E7D41C4ECCC7F9C4", "target": "Seguire il bambino Hoobigo dalle scaglie blu in compagnia di Wuk Lamat" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TODO_04", "hash": "B43ED6F13F612BED", "target": "Parlare con Wuk Lamat" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_001", "hash": "D711C988090B6935", "target": "Dunque, dobbiamo andare in un posto chiamato True Vue, nel settore orientale. Questo trasportatore dovrebbe portarci lì." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_002", "hash": "A9FA79D02201DDE8", "target": "Sai, una volta che ci fai l'abitudine, sono anche divertenti. Vieni, <split(<string(gstr1)>, ,1)>!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_010", "hash": "1F7F405B0C0EBC71", "target": "Pensi che sia il posto giusto?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_011", "hash": "85D269696ABC8AC2", "target": "Però non vedo gli altri..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_012", "hash": "AAA003FCB7D5E19E", "target": "Be', invece di starcene qui ad aspettare, potremmo esplorare ancora un po'." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_013", "hash": "A0A30846D7995928", "target": "Eh? <split(<string(gstr1)>, ,1)>, guarda laggiù!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_014", "hash": "52E04AAF6006B966", "target": "Un bambino Mamool Ja... Cosa ci fa qui?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_015", "hash": "84BA33B64848BB50", "target": "Hai notato anche tu, vero? La somiglianza con Zoraal Ja." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_016", "hash": "0FA2D311187B1121", "target": "Le scaglie blu di un Boonewa e i tratti di un Hoobigo..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_017", "hash": "81AF68C16847AA38", "target": "Non può essere una coincidenza." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_018", "hash": "C58674BB0A83DC7F", "target": "In ogni caso, non possiamo lasciare un bambino così piccolo tutto solo." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_019", "hash": "3C58AA780476FCD6", "target": "Vieni, seguiamolo!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_100_019", "hash": "A70D0540CDAD2426", "target": "Credo sia corso da questa parte..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_020", "hash": "31ACC571C6BBE5EE", "target": "Quindi questa è True Vue. Non so bene cosa sto guardando, ma sembra un posto vivace!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_021", "hash": "BBF2849FD3A94DB0", "target": "Quell'edificio è praticamente l'unico senza luci accese. Forse al momento è chiuso?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_022", "hash": "8231A914FCF1CC3F", "target": "Uuaaah!?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_023", "hash": "9F715B1CC1D7F68A", "target": "N-Non ti avevo visto..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_024", "hash": "337FC3CF4F058A4A", "target": "Ascolta, non vogliamo farti del male. Vogliamo solo parlare." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_025", "hash": "43306135F879B303", "target": "È un po' strano, non trovi? Scappa quando ci avviciniamo, poi ricompare all'improvviso..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_026", "hash": "8F0353734599DD2B", "target": "Forse vuole portarci da qualche parte?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_027", "hash": "BE3440E2014F888F", "target": "È così? Vuoi che ti seguiamo?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_028", "hash": "E448F9002EC15043", "target": "Allora è proprio così! Bene, facci strada!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_030", "hash": "9EFDD5B841DDBBF9", "target": "Vediamo dove ci porta." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_GULOOLJA_000_040", "hash": "4421C94215A55747", "target": "...!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_SYSTEM_000_044", "hash": "BA70C4EDA64BBCF2", "target": "Seguire il bambino Hoobigo dalle scaglie blu?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_Q1_000_000", "hash": "EB588CC646DD0F4F", "target": "Cosa vuoi fare?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_A1_000_001", "hash": "1BC242E3E91C1E1B", "target": "Parlare" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_A1_000_002", "hash": "04FC3A36E379E073", "target": "Separarsi" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_A1_000_003", "hash": "5E7465CC09960E9E", "target": "Niente" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_100_044", "hash": "73D51D10CE27A8AA", "target": "Cerchiamo di non perderlo di vista, stavolta!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_Q2_000_000", "hash": "1EDB80CAFE8E4487", "target": "Vuoi davvero separarti da Wuk Lamat?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_100_045", "hash": "87C514F8313966AC", "target": "Mh? Il cibo alessandrino ti ha scombussolato lo stomaco? Va bene, dirò al piccolo che ti serve un po' di tempo. Ti aspetteremo al punto di partenza." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_SYSTEM_110_045", "hash": "0F9849D4E52095B8", "target": "Wuk Lamat non è ancora arrivata. Assicurati che sia al tuo fianco prima di proseguire." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_120_045", "hash": "8962B0DC3B12B922", "target": "Dannazione, l'abbiamo perso! Sarà meglio tornare al punto di partenza..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_SYSTEM_130_045", "hash": "E11D89D0D3763EF7", "target": "Parla con il bambino Hoobigo dalle scaglie blu nella zona ricreativa per riprovare." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_GULOOLJA_000_045", "hash": "9F8BFF5E64AA92FF", "target": "...!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_050", "hash": "62865C83A6DDB1E9", "target": "È qui che volevi portarci?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_051", "hash": "45E7BA8F57CB89A9", "target": "Che posto è questo? Se è pensato per rilassarsi, con me non funziona..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_052", "hash": "95D67D1BFC2D7202", "target": "Ehi, come ti chiami?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_053", "hash": "A51E18DF1B71ED9E", "target": "Quindi non hai ancora voglia di parlare..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_054", "hash": "8B614746931724F2", "target": "Parla solo con chi lo fa sentire del tutto a suo agio." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_055", "hash": "5A4E1514E39ABFF1", "target": "Lo conosci?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_056", "hash": "84FF9A4782AA01A7", "target": "In un certo senso. Ma lasciamo stare. Che ne dite di qualcosa da bere?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_057", "hash": "49EA5B2174C5E2E1", "target": "Siete così adorabili che offre la casa. Vi consiglio la nostra specialità─il Sua Maestà. Ne preparo uno senza liquore anche per il piccolo." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_058", "hash": "EE3469931A36E8DD", "target": "Ehm, grazie, ma no. Dobbiamo incontrare un'amica di nome Cahciua." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_059", "hash": "FB9ACC2479267D8C", "target": "Ma per strada ci siamo imbattuti nel bambino, e lui ci ha portato qui." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_060", "hash": "6D5904336642183A", "target": "Ohhh, quindi siete con Cahciua." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_061", "hash": "EF39C4E1FA9D3D56", "target": "In tal caso, andate a parlare con il grosso Tassos, laggiù. Vi mostrerà un posto divertente." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_062", "hash": "7476EE0F8CF2E073", "target": "E lui?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_063", "hash": "400556D1123C7B3E", "target": "Non credo che abbia voglia di parlare, perciò può restare al bancone con me." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_064", "hash": "85F8A93086D18F3B", "target": "La situazione è diventata strana, ma non pensi che ci stiamo infilando in una trappola, vero?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_065", "hash": "7E34942071AADC94", "target": "Accidenti, qui è tutto fin troppo sospetto..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_070", "hash": "EAF01758269C6B7F", "target": "Se alla fine vi va quel drink, basta dirlo." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_GULOOLJA_000_075", "hash": "B50D8F571265E752", "target": "..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TASSOS_000_080", "hash": "273A4B42A415C42B", "target": "Sembra che tu abbia fretta di andare, ma la tua amica?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_090", "hash": "B5449B099F1CF6FD", "target": "Cosa sarebbe questo «posto divertente»? Cahciua è lì?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_091", "hash": "2D98A6AB4FD96705", "target": "Be', suppongo che ci sia un solo modo per scoprirlo..." }
  ]
}
